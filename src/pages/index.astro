---
import BaseLayout from '../layouts/BaseLayout.astro';
import { charities, donationOptions } from '../data/charities';
import { currencies, defaultCurrency } from '../data/currencies';
import { countries } from '../data/countries';

const stripePublishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ?? '';
---

<BaseLayout
  title="Donate | Happier Lives Institute"
  description="Give to the world's most cost-effective wellbeing charities. Choose the Happier Lives Fund or split your donation between our recommended charities."
>
  <main class="page">

    <!-- Header -->
    <header class="page-header">
      <a href="https://happierlivesinstitute.org" target="_blank" rel="noopener" aria-label="Happier Lives Institute homepage">
        <img src="/images/hli-logo.png" alt="Happier Lives Institute" class="logo" width="160" height="48" />
      </a>
      <p class="header-subtitle">Donation Portal</p>
    </header>

    <!-- Progress bar (rendered by JS) -->
    <nav class="progress-nav" id="progressNav" aria-label="Donation steps"></nav>

    <!-- Form card -->
    <div class="form-card">

      <!-- ── Step 1: Destination ── -->
      <section class="step active" id="step-1" aria-labelledby="step1-title">
        <h2 id="step1-title" class="step-title">Where would you like to give?</h2>
        <p class="step-desc">Each option reflects HLI's latest research on wellbeing impact.</p>

        <div class="option-list" role="radiogroup" aria-labelledby="step1-title">
          {donationOptions.map((opt) => (
            <label class="option-card" for={`dest-${opt.id}`}>
              <input
                type="radio"
                id={`dest-${opt.id}`}
                name="destination"
                value={opt.id}
                class="option-radio"
              />
              <div class="option-body">
                <div class="option-header-row">
                  <span class="option-name">{opt.name}</span>
                  {opt.recommended && <span class="badge-recommended">Recommended</span>}
                  <button
                    type="button"
                    class="info-btn"
                    aria-label={`More about ${opt.name}`}
                    data-tooltip={opt.description}
                  >ⓘ</button>
                </div>
                <p class="option-tagline">{opt.tagline}</p>
              </div>
              <span class="option-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </section>

      <!-- ── Step 2: Amount ── -->
      <section class="step" id="step-2" aria-labelledby="step2-title">
        <h2 id="step2-title" class="step-title">How much would you like to give?</h2>

        <div class="freq-toggle" role="group" aria-label="Donation frequency">
          <button type="button" class="freq-btn" data-freq="one-off">One-time</button>
          <button type="button" class="freq-btn" data-freq="monthly">Monthly</button>
          <button type="button" class="freq-btn active freq-btn-pledge" data-freq="pledge">
            <span class="badge-recommended freq-btn-sticker">Recommended</span>
            Pledge
          </button>
        </div>

        <div class="currency-wrapper">
          <select id="currency" aria-label="Currency">
            {currencies.map((c) => (
              <option value={c.code} selected={c.code === defaultCurrency}>
                {c.code} {c.symbol}
              </option>
            ))}
          </select>
        </div>

        <div id="manualAmountGroup" style="display:none;">
          <div class="amount-row">
            <div class="amount-input-wrapper">
              <span class="amount-symbol" id="currencySymbol">$</span>
              <input
                type="number"
                id="amount"
                placeholder="0"
                min="1"
                step="1"
                aria-label="Donation amount"
              />
            </div>
          </div>

          <div class="preset-amounts" aria-label="Preset amounts">
            {[25, 50, 100, 250, 500, 1000].map((n) => (
              <button type="button" class="preset-btn" data-amount={n}>{n}</button>
            ))}
          </div>

          <p class="amount-note" id="amountNote"></p>
        </div>

        <div id="pledgeCalculator">
          <div class="amount-row">
            <div class="amount-input-wrapper">
              <span class="amount-symbol" id="pledgeCurrencySymbol">$</span>
              <input
                type="number"
                id="pledgeIncome"
                placeholder="Annual income"
                min="1"
                step="1"
                aria-label="Annual income"
              />
            </div>
          </div>

          <p class="pledge-pct-label">What % of your income would you like to pledge?</p>
          <div class="stepped-selector" role="radiogroup" aria-label="Pledge percentage">
            {[1, 3, 5, 10].map((pct) => (
              <label class="step-pill">
                <input type="radio" name="pledge-pct" value={pct} />
                <span>{pct}%</span>
              </label>
            ))}
          </div>

          <p class="pledge-result" id="pledgeResult"></p>
        </div>
      </section>

      <!-- ── Step 3: Split (Recommended Charities only) ── -->
      <section class="step" id="step-3" aria-labelledby="step3-title">
        <h2 id="step3-title" class="step-title">How would you like to split your donation?</h2>
        <p class="step-desc">Adjust the sliders to divide your gift between the charities.</p>

        <!-- HLI contribution stepped selector -->
        <div class="hli-contrib-card">
          <div class="hli-contrib-header">
            <span class="hli-contrib-label">Contribution to HLI's research</span>
            <button
              type="button"
              class="info-btn"
              aria-label="More about the HLI contribution"
              data-tooltip="HLI is the research organisation behind these recommendations. A small contribution to HLI helps fund the rigorous work that identifies high-impact opportunities."
            >ⓘ</button>
          </div>
          <div class="stepped-selector" role="radiogroup" aria-label="HLI percentage">
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={0} />
              <span>0%</span>
            </label>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={5} />
              <span>5%</span>
            </label>
            <div class="step-pill-wrapper">
              <span class="badge-recommended">Recommended</span>
              <label class="step-pill">
                <input type="radio" name="hli-pct" value={10} checked />
                <span>10%</span>
              </label>
            </div>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={15} />
              <span>15%</span>
            </label>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={25} />
              <span>25%</span>
            </label>
          </div>
          <label class="hli-custom-toggle">
            <input type="checkbox" id="hliCustomToggle" />
            <span>Choose a custom %</span>
          </label>
          <div class="hli-custom-input" id="hliCustomInput">
            <input
              type="number"
              id="hliCustomPct"
              min="0"
              max="100"
              placeholder="Enter a percentage (0–100)"
            />
          </div>
        </div>

        <!-- Charity split sliders -->
        <div class="charity-splits" id="charitySplits">
          {charities.map((c, i) => (
            <div class="charity-slider-row" data-charity-id={c.id}>
              <div class="charity-slider-header">
                <div class="charity-info">
                  <span class="charity-name">{c.name}</span>
                  <span class={`charity-tier-badge charity-tier-badge--${c.tier}`}>
                    {c.tier === 'top' ? 'Top Charity' : 'Promising'}
                  </span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label={`More about ${c.name}`}
                    data-tooltip={c.fullDescription}
                  >ⓘ</button>
                </div>
                <span class="charity-pct-label" id={`pct-${c.id}`}>0%</span>
              </div>
              <input
                type="range"
                class="charity-range"
                id={`range-${c.id}`}
                min="0"
                max="100"
                value="0"
                step="1"
                aria-label={`${c.name} percentage`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="25"
              />
            </div>
          ))}
        </div>

        <div class="split-total" id="splitTotal">
          <span>Total: </span><span id="splitTotalPct">100%</span>
          <span class="split-total-note" id="splitTotalNote"></span>
        </div>

        <!-- Impact calculator -->
        <div class="impact-card">
          <div class="impact-header-row">
            <span class="impact-heading">Estimated impact</span>
            <button
              type="button"
              class="info-btn"
              aria-label="About this estimate"
              data-tooltip="WELLBYs (Wellbeing-Adjusted Life Years) measure the wellbeing impact of your donation using HLI's cost-per-WELLBY estimates. Depression years averted = WELLBYs ÷ 1.3. Confidence score reflects the depth and quality of evidence behind each charity's estimate, weighted by your allocation."
            >ⓘ</button>
          </div>
          <div class="impact-metrics">
            <div class="impact-metric">
              <div class="impact-number" id="impactWellbys">—</div>
              <div class="impact-desc">WELLBYs generated</div>
            </div>
            <div class="impact-metric impact-metric--secondary">
              <div class="impact-number" id="impactDepressionYears">—</div>
              <div class="impact-desc">years of depression averted</div>
            </div>
            <div class="impact-metric impact-metric--secondary">
              <div class="impact-number" id="impactConfidence">—</div>
              <div class="impact-desc">evidence confidence</div>
            </div>
          </div>
          <div class="impact-breakdown" id="impactBreakdown"></div>
        </div>

        <!-- Outcome cards -->
        <div class="outcome-cards">
          <div class="outcome-card">
            <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <!-- Person -->
              <circle cx="9" cy="7" r="3"/>
              <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
              <!-- Speech bubble -->
              <path d="M16 8h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-1l-2 2v-2h-1a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/>
            </svg>
            <div class="outcome-number" id="outcome-strongminds">—</div>
            <div class="outcome-label">One-to-one psychotherapy courses funded</div>
          </div>
          <div class="outcome-card">
            <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <!-- Three people -->
              <circle cx="9" cy="7" r="2.5"/>
              <path d="M4 21v-1.5A3.5 3.5 0 0 1 7.5 16h3A3.5 3.5 0 0 1 14 19.5V21"/>
              <circle cx="17" cy="8" r="2"/>
              <path d="M15 21v-1a3 3 0 0 1 3-3h0a3 3 0 0 1 3 3v1"/>
            </svg>
            <div class="outcome-number" id="outcome-friendship-bench">—</div>
            <div class="outcome-label">Group psychotherapy courses funded</div>
          </div>
          <div class="outcome-card">
            <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <!-- Shield with checkmark -->
              <path d="M12 3l8 3.5v5C20 16.4 16.6 21 12 22 7.4 21 4 16.4 4 11.5v-5L12 3z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <div class="outcome-number" id="outcome-pure-earth">—</div>
            <div class="outcome-label">Children protected from lead exposure</div>
          </div>
          <div class="outcome-card">
            <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <!-- Bowl with food -->
              <path d="M4 11h16"/>
              <path d="M5 11a7 7 0 0 0 14 0"/>
              <path d="M12 4c-1.5 0-2.5 1-2.5 2s1 1.5 1 2.5"/>
              <path d="M15 4c1 .5 1.5 1.5 1.5 2.5 0 .8-.4 1.5-1 2"/>
            </svg>
            <div class="outcome-number" id="outcome-taimaka">—</div>
            <div class="outcome-label">Children protected from malnutrition</div>
          </div>
        </div>

        <!-- Putting your impact in context -->
        <div class="impact-context-card">
          <div class="impact-header-row">
            <span class="impact-heading">Putting your impact in context</span>
          </div>
          <div class="impact-metrics impact-metrics--two">
            <div class="impact-metric">
              <div class="impact-number" id="contextTreasuryValue">—</div>
              <div class="impact-desc">UK Treasury value of wellbeing created</div>
            </div>
            <div class="impact-metric impact-metric--secondary">
              <div class="impact-number" id="contextStandardCharity">—</div>
              <div class="impact-desc">equivalent donation to a standard charity</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Step 4: About you ── -->
      <section class="step" id="step-4" aria-labelledby="step4-title">
        <h2 id="step4-title" class="step-title">About you</h2>
        <p class="step-desc">We need a few details to process your donation and send you a receipt.</p>

        <div class="form-row-2">
          <div class="form-group">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" autocomplete="given-name" required />
          </div>
          <div class="form-group">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" autocomplete="family-name" required />
          </div>
        </div>

        <div class="form-group">
          <label for="email">Email address</label>
          <input type="email" id="email" autocomplete="email" required />
        </div>

        <div class="form-group">
          <label for="country">Country</label>
          <select id="country" autocomplete="country">
            <option value="">Select country…</option>
            {countries.map(c => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Gift Aid (UK only) -->
        <div class="gift-aid-card" id="giftAidSection" hidden>
          <div class="gift-aid-header">
            <strong>Boost your donation by 25% at no extra cost</strong>
          </div>
          <p class="gift-aid-desc">
            If you're a UK taxpayer, HLI can reclaim Gift Aid on your donation.
            This means your gift is worth 25% more at no cost to you.
          </p>
          <label class="checkbox-label">
            <input type="checkbox" id="giftAid" />
            <span>
              I am a UK taxpayer and I understand that if I pay less Income Tax and/or Capital
              Gains Tax in the current tax year than the amount of Gift Aid claimed on all my
              donations, it is my responsibility to pay any difference.
            </span>
          </label>
        </div>

        <label class="checkbox-label anonymous-label">
          <input type="checkbox" id="anonymous" />
          <span>Keep my donation anonymous</span>
        </label>
      </section>

      <!-- ── Step 5: Review ── -->
      <section class="step" id="step-5" aria-labelledby="step5-title">
        <h2 id="step5-title" class="step-title">Review your donation</h2>

        <div class="review-summary" id="reviewSummary">
          <!-- Populated by JS -->
        </div>

        <div class="trust-signals">
          <div class="trust-signal">
            <span class="trust-icon">🔒</span>
            <span>Secure payment via Stripe</span>
          </div>
          <div class="trust-signal">
            <span class="trust-icon">✓</span>
            <span>No percentage taken from programme donations</span>
          </div>
          <div class="trust-signal">
            <span class="trust-icon">📊</span>
            <span>
              <a href="https://happierlivesinstitute.org/transparency" target="_blank" rel="noopener">
                Full financial transparency
              </a>
            </span>
          </div>
        </div>

        <!-- Payment loading state -->
        <div id="paymentLoading" class="payment-loading">
          <div class="spinner"></div>
          <span>Preparing secure payment…</span>
        </div>

        <!-- Payment Element + pay button (shown once Stripe is ready) -->
        <div id="paymentArea" style="display:none;">
          <div id="payment-element"></div>
          <div id="paymentError" class="payment-error" style="display:none;" role="alert"></div>
          <button type="button" class="btn-complete" id="payBtn" disabled>
            Pay now →
          </button>
          <p class="stripe-note">Secured by Stripe · Your card details are never sent to our servers.</p>
        </div>

        <!-- Error state: shown if the API call fails entirely -->
        <div id="paymentInitError" class="payment-init-error" style="display:none;" role="alert">
          <p>We couldn't prepare your payment. Please check your connection and try again.</p>
          <button type="button" class="btn-retry" id="retryBtn">Try again</button>
        </div>
      </section>

    </div><!-- /.form-card -->

    <!-- Navigation -->
    <div class="form-nav">
      <button type="button" class="btn btn-back" id="btnBack">← Back</button>
      <button type="button" class="btn btn-primary" id="btnNext">Continue →</button>
    </div>

    <!-- Tooltip overlay -->
    <div class="tooltip-popup" id="tooltipPopup" role="tooltip" aria-live="polite" hidden>
      <p id="tooltipText"></p>
    </div>

  </main>
</BaseLayout>

<!-- ════════════════════════════════════════════
     Client-side script
     ════════════════════════════════════════════ -->
<script define:vars={{ charities, currencies, defaultCurrency, stripePublishableKey }}>
  // ── State ──────────────────────────────────────────────────────────────
  const state = {
    step: 1,
    destination: /** @type {'hlf'|'recommended'|'hli'|null} */ (null),
    frequency: 'pledge',
    currency: defaultCurrency,
    amount: null,
    pledgeIncome: null,
    pledgePct: null,
    hliPct: 10,
    splits: Object.fromEntries(charities.map((c) => [c.id, 0])),
    donor: { firstName: '', lastName: '', email: '', country: '', giftAid: false, anonymous: false },
  };

  // ── Step sequence ───────────────────────────────────────────────────────
  function getStepSequence() {
    return state.destination === 'recommended' ? [1, 2, 3, 4, 5] : [1, 2, 4, 5];
  }

  function stepLabel(n) {
    return { 1: 'Destination', 2: 'Amount', 3: 'Split', 4: 'Your details', 5: 'Review' }[n];
  }

  function nextStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx < seq.length - 1 ? seq[idx + 1] : null;
  }

  function prevStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx > 0 ? seq[idx - 1] : null;
  }

  // ── DOM helpers ─────────────────────────────────────────────────────────
  function qs(sel) { return document.querySelector(sel); }
  function qsa(sel) { return document.querySelectorAll(sel); }

  // ── Progress bar ────────────────────────────────────────────────────────
  function renderProgress() {
    const nav = qs('#progressNav');
    const seq = getStepSequence();
    const pos = seq.indexOf(state.step) + 1;
    const total = seq.length;

    nav.innerHTML = seq.map((stepNum, i) => {
      const done = i < seq.indexOf(state.step);
      const current = stepNum === state.step;
      const cls = done ? 'prog-step done' : current ? 'prog-step current' : 'prog-step';
      const label = stepLabel(stepNum);
      return `
        <div class="${cls}" aria-current="${current ? 'step' : 'false'}">
          <div class="prog-circle">${done ? '✓' : i + 1}</div>
          <div class="prog-label">${label}</div>
        </div>
        ${i < seq.length - 1 ? '<div class="prog-line' + (done ? ' done' : '') + '"></div>' : ''}
      `;
    }).join('');

    // Screen reader text
    nav.setAttribute('aria-label', `Step ${pos} of ${total}: ${stepLabel(state.step)}`);
  }

  // ── Step transitions ────────────────────────────────────────────────────
  function goToStep(n) {
    const current = qs(`.step.active`);
    const next = qs(`#step-${n}`);
    if (!next || current === next) return;

    current.classList.remove('active');
    current.classList.add('leaving');

    setTimeout(() => {
      current.classList.remove('leaving');
      state.step = n;
      next.classList.add('entering');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          next.classList.remove('entering');
          next.classList.add('active');
          renderProgress();
          renderNavButtons();
          onStepEnter(n);
        });
      });
    }, 220);
  }

  function onStepEnter(n) {
    if (n === 3) renderImpact();
    if (n === 5) { renderReview(); initPaymentElement(); }
  }

  // ── Nav buttons ─────────────────────────────────────────────────────────
  function renderNavButtons() {
    const btnBack = qs('#btnBack');
    const btnNext = qs('#btnNext');
    const seq = getStepSequence();
    const isFirst = seq[0] === state.step;
    const isLast = seq[seq.length - 1] === state.step;

    btnBack.style.visibility = isFirst ? 'hidden' : 'visible';
    btnNext.style.display = isLast ? 'none' : 'inline-flex';
  }

  // ── Validation ──────────────────────────────────────────────────────────
  function isStepValid() {
    switch (state.step) {
      case 1: return state.destination !== null;
      case 2: return state.amount !== null && state.amount > 0;
      case 3: return true; // auto-normalizes on advance
      case 4: {
        const { firstName, lastName, email } = state.donor;
        return firstName.trim() && lastName.trim() && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }
      default: return true;
    }
  }

  // ── Currency symbol ──────────────────────────────────────────────────────
  function getCurrencySymbol(code) {
    const c = currencies.find((x) => x.code === code);
    return c ? c.symbol : code;
  }

  function updateCurrencySymbol() {
    qs('#currencySymbol').textContent = getCurrencySymbol(state.currency);
    qs('#pledgeCurrencySymbol').textContent = getCurrencySymbol(state.currency);
    renderPresetLabels();
  }

  function renderPresetLabels() {
    qsa('.preset-btn').forEach((btn) => {
      const amt = Number(btn.dataset.amount);
      btn.textContent = amt >= 1000 ? `${amt}` : `${amt}`;
    });
  }

  // ── Exchange rates ────────────────────────────────────────────────────────
  let fxRates = {};

  async function loadFxRates() {
    try {
      const res  = await fetch('https://api.frankfurter.app/latest?base=USD');
      const data = await res.json();
      fxRates = data.rates ?? {};
      fxRates['USD'] = 1;
    } catch {
      fxRates = {};
    }
  }

  function toUSD(amount) {
    const rate = fxRates[state.currency];
    return rate ? amount / rate : amount;
  }

  // ── Impact calculator ────────────────────────────────────────────────────
  function renderImpact() {
    const amt = toUSD(state.amount || 0);
    let years = 0;
    const wellbysEl = qs('#impactWellbys');
    const deprYrsEl = qs('#impactDepressionYears');
    const confEl = qs('#impactConfidence');
    const bkEl = qs('#impactBreakdown');

    if (state.destination !== 'recommended' || amt <= 0) {
      wellbysEl.textContent = '—';
      deprYrsEl.textContent = '—';
      confEl.textContent = '—';
      confEl.className = 'impact-number impact-number--conf';
      confEl.style.color = '';
      bkEl.innerHTML = '<p class="impact-hint">Enter an amount to see your impact.</p>';
      charities.forEach((c) => {
        const el = qs(`#outcome-${c.id}`);
        if (el) el.textContent = '—';
      });
      const tvEl = qs('#contextTreasuryValue');
      const scEl = qs('#contextStandardCharity');
      if (tvEl) tvEl.textContent = '—';
      if (scEl) scEl.textContent = '—';
      return;
    }

    const charityAmt = amt * (1 - state.hliPct / 100);
    const totalSplits = Object.values(state.splits).reduce((s, v) => s + v, 0);

    let totalWellbys = 0;
    let totalConfidence = 0;
    const breakdown = [];

    charities.forEach((c) => {
      const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
      const allocated = charityAmt * fraction;
      const wellbys = allocated / c.costPerWellby;
      totalWellbys += wellbys;
      totalConfidence += c.confidenceScore * fraction;
      if (wellbys > 0) breakdown.push({ name: c.name, wellbys });
    });

    const depressionYears = totalWellbys / 1.3;

    const fmt = (n) => n < 1 ? n.toFixed(2) : n < 100 ? n.toFixed(1) : Math.round(n).toLocaleString();

    let confLabel, confClass;
    let confColor;
    if (totalConfidence >= 9)        { confLabel = 'Very Low Risk';  confColor = '#1a4d2e'; }
    else if (totalConfidence > 7.5)  { confLabel = 'Low Risk';       confColor = '#2d6040'; }
    else if (totalConfidence >= 6.5) { confLabel = 'Medium Risk';    confColor = '#c17f3a'; }
    else if (totalConfidence >= 5)   { confLabel = 'High Risk';      confColor = '#c0392b'; }
    else                             { confLabel = 'Very High Risk'; confColor = '#7b1c1c'; }

    wellbysEl.textContent = fmt(totalWellbys);
    deprYrsEl.textContent = fmt(depressionYears);
    confEl.textContent = confLabel;
    confEl.className = 'impact-number impact-number--conf';
    confEl.style.color = confColor;
    bkEl.innerHTML = breakdown
      .map((b) => `<div class="impact-bk-row"><span>${b.name}</span><span>${fmt(b.wellbys)} WELLBYs</span></div>`)
      .join('');

    // Outcome cards
    charities.forEach((c) => {
      const el = qs(`#outcome-${c.id}`);
      if (!el) return;
      const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
      const allocated = charityAmt * fraction;
      const outcomes = allocated / c.costPerOutcome;
      el.textContent = outcomes > 0 ? fmt(outcomes) : '—';
    });

    // Context section — convert USD base values back to selected currency for display
    const rate = fxRates[state.currency] || 1;
    const currSym = getCurrencySymbol(state.currency);
    const tvEl = qs('#contextTreasuryValue');
    const scEl = qs('#contextStandardCharity');
    if (tvEl) tvEl.textContent = currSym + fmt(totalWellbys * 22258.36 * rate);
    if (scEl) scEl.textContent = currSym + fmt(totalWellbys * 17366.90 * rate);
  }

  // ── Split sliders ────────────────────────────────────────────────────────
  function renderSplitTotals() {
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);
    const el = qs('#splitTotalPct');
    const note = qs('#splitTotalNote');
    el.textContent = `${Math.round(total)}%`;
    if (Math.abs(total - 100) > 0.5) {
      el.style.color = 'var(--color-error)';
      note.textContent = `— will auto-adjust to 100% when you continue`;
    } else {
      el.style.color = 'var(--color-success)';
      note.textContent = '';
    }
  }

  function normalizeSplits() {
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);
    if (total === 0) {
      const eq = 100 / charities.length;
      charities.forEach((c) => { state.splits[c.id] = eq; });
    } else if (Math.abs(total - 100) > 0.5) {
      charities.forEach((c) => { state.splits[c.id] = (state.splits[c.id] / total) * 100; });
    }
    // Sync sliders to normalized values
    charities.forEach((c) => {
      const slider = qs(`#range-${c.id}`);
      const label = qs(`#pct-${c.id}`);
      if (slider) slider.value = String(Math.round(state.splits[c.id]));
      if (label) label.textContent = `${Math.round(state.splits[c.id])}%`;
    });
    renderSplitTotals();
    renderImpact();
  }

  // ── Review summary ────────────────────────────────────────────────────────
  function renderReview() {
    const sym = getCurrencySymbol(state.currency);
    const dest = state.destination === 'hlf'
      ? 'Happier Lives Fund'
      : state.destination === 'hli'
      ? 'Happier Lives Institute'
      : 'Recommended Charities';
    const freq = state.frequency !== 'one-off' ? '/month' : ' one-time';
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);

    let splits = '';
    if (state.destination === 'recommended') {
      splits = `
        <div class="review-row"><span>HLI contribution</span><span>${state.hliPct}%</span></div>
        ${charities.map((c) => `
          <div class="review-row"><span>${c.name}</span><span>${Math.round(state.splits[c.id] / (total / 100))}%</span></div>
        `).join('')}
      `;
    }

    let impact = '';
    if (state.destination === 'recommended') {
      const amt = state.amount || 0;
      const charityAmt = amt * (1 - state.hliPct / 100);
      const totalSplits = Object.values(state.splits).reduce((s, v) => s + v, 0);
      let totalWellbys = 0;
      charities.forEach((c) => {
        const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
        totalWellbys += (charityAmt * fraction) / c.costPerWellby;
      });
      const deprYrs = totalWellbys / 1.3;
      if (totalWellbys > 0) {
        const fmt = (n) => n < 1 ? n.toFixed(2) : n < 100 ? n.toFixed(1) : Math.round(n).toLocaleString();
        impact = `<div class="review-row impact-row"><span>Estimated impact</span><span>${fmt(totalWellbys)} WELLBYs · ${fmt(deprYrs)} yrs depression averted</span></div>`;
      }
    }

    const pledgeRow = state.frequency === 'pledge' && state.pledgeIncome && state.pledgePct
      ? `<div class="review-row"><span>Pledge</span><span>${state.pledgePct}% of ${sym}${state.pledgeIncome.toLocaleString()}/yr</span></div>`
      : '';

    qs('#reviewSummary').innerHTML = `
      <div class="review-row"><span>Giving to</span><span>${dest}</span></div>
      <div class="review-row"><span>Amount</span><span>${sym}${state.amount}${freq}</span></div>
      ${pledgeRow}
      ${splits}
      ${impact}
      ${state.donor.giftAid ? '<div class="review-row"><span>Gift Aid</span><span>✓ Claimed</span></div>' : ''}
    `;
  }

  // ── Stripe payment ────────────────────────────────────────────────────────
  let stripeInstance = null;
  let stripeElements = null;
  let paymentElementMounted = false;

  /** Lazy-load Stripe.js from CDN the first time it's needed */
  function loadStripeJs() {
    if (window.Stripe) return Promise.resolve(window.Stripe);
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://js.stripe.com/v3/';
      script.onload = () => resolve(window.Stripe);
      script.onerror = () => reject(new Error('Failed to load Stripe.js'));
      document.head.appendChild(script);
    });
  }

  /** Reset the payment UI and unmount the Payment Element */
  function teardownPaymentElement() {
    if (stripeElements) {
      const el = stripeElements.getElement('payment');
      if (el) el.unmount();
      stripeElements = null;
      paymentElementMounted = false;
    }
    qs('#paymentArea').style.display = 'none';
    qs('#paymentLoading').style.display = 'flex';
    qs('#paymentInitError').style.display = 'none';
    qs('#paymentError').style.display = 'none';
    qs('#payBtn').disabled = true;
  }

  /** Called when step 5 is entered — creates intent and mounts Payment Element */
  async function initPaymentElement() {
    teardownPaymentElement();

    try {
      // 1. Lazy-load Stripe.js
      const StripeConstructor = await loadStripeJs();
      if (!stripeInstance) stripeInstance = StripeConstructor(stripePublishableKey);

      // 2. Create PaymentIntent or Subscription on the server
      const response = await fetch('/api/create-payment-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount:       state.amount,
          currency:     state.currency,
          frequency:    state.frequency,
          pledgeIncome: state.pledgeIncome,
          pledgePct:    state.pledgePct,
          donor:        state.donor,
          destination:  state.destination,
          splits:       state.splits,
          hliPct:       state.hliPct,
        }),
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error ?? `Server error ${response.status}`);
      }

      const { clientSecret } = await response.json();

      // 3. Create Elements instance with HLI brand appearance
      stripeElements = stripeInstance.elements({
        clientSecret,
        appearance: {
          theme: 'stripe',
          variables: {
            colorPrimary:     '#1c3a5e',
            colorBackground:  '#ffffff',
            colorText:        '#1c3a5e',
            colorDanger:      '#c0392b',
            fontFamily:       'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            borderRadius:     '8px',
          },
          rules: {
            '.Input': {
              border:     '1.5px solid #e0dbd2',
              boxShadow:  'none',
            },
            '.Input:focus': {
              border:     '1.5px solid #1c3a5e',
              boxShadow:  '0 0 0 3px rgba(28,58,94,0.1)',
            },
            '.Label': {
              color:      '#4a5a50',
              fontSize:   '0.875rem',
              fontWeight: '500',
            },
          },
        },
      });

      // 4. Mount the Payment Element
      const paymentElement = stripeElements.create('payment', {
        layout: { type: 'tabs', defaultCollapsed: false },
        wallets: { applePay: 'auto', googlePay: 'auto' },
      });

      qs('#payment-element').innerHTML = '';
      paymentElement.mount('#payment-element');
      paymentElementMounted = true;

      // Enable Pay button once element is ready
      paymentElement.on('ready', () => {
        qs('#payBtn').disabled = false;
        qs('#paymentLoading').style.display = 'none';
        qs('#paymentArea').style.display = 'block';
      });

      // Clear inline errors when user edits payment details
      paymentElement.on('change', (event) => {
        if (event.complete) {
          qs('#paymentError').style.display = 'none';
          qs('#paymentError').textContent = '';
        }
      });

    } catch (err) {
      console.error('Payment init error:', err.message);
      qs('#paymentLoading').style.display = 'none';
      qs('#paymentInitError').style.display = 'block';
    }
  }

  /** Called when the Pay button is clicked */
  async function submitPayment() {
    if (!stripeInstance || !stripeElements) return;

    const payBtn  = qs('#payBtn');
    const errorEl = qs('#paymentError');

    payBtn.disabled    = true;
    payBtn.textContent = 'Processing…';
    errorEl.style.display = 'none';

    const { error } = await stripeInstance.confirmPayment({
      elements: stripeElements,
      confirmParams: {
        return_url: `${window.location.origin}/success`,
        payment_method_data: {
          billing_details: {
            name:  `${state.donor.firstName} ${state.donor.lastName}`.trim(),
            email: state.donor.email,
          },
        },
      },
      // Cards & wallets complete inline; redirect methods use return_url
      redirect: 'if_required',
    });

    if (error) {
      errorEl.textContent = (error.type === 'card_error' || error.type === 'validation_error')
        ? error.message
        : 'An unexpected error occurred. Please try again.';
      errorEl.style.display = 'block';
      payBtn.disabled    = false;
      payBtn.textContent = 'Pay now →';
    } else {
      // Inline success (card / wallet — no redirect needed)
      window.location.href = '/success';
    }
  }

  // ── Event listeners ───────────────────────────────────────────────────────
  function initEvents() {
    // Step 1: destination
    qsa('[name="destination"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.destination = radio.value;
        qsa('.option-card').forEach((c) => c.classList.remove('selected'));
        radio.closest('.option-card').classList.add('selected');
        renderNavButtons();
      });
    });

    // Step 2: frequency
    qsa('.freq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        qsa('.freq-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        state.frequency = btn.dataset.freq;
        const isPledge = state.frequency === 'pledge';
        qs('#pledgeCalculator').style.display = isPledge ? 'block' : 'none';
        qs('#manualAmountGroup').style.display = isPledge ? 'none' : 'block';
        state.amount = null;
        renderNavButtons();
      });
    });

    // Step 2: currency
    qs('#currency').addEventListener('change', (e) => {
      state.currency = e.target.value;
      updateCurrencySymbol();
    });

    // Step 2: amount input
    qs('#amount').addEventListener('input', (e) => {
      state.amount = e.target.value ? Number(e.target.value) : null;
      qsa('.preset-btn').forEach((b) => b.classList.remove('active'));
      if (state.amount) {
        const match = qs(`.preset-btn[data-amount="${state.amount}"]`);
        if (match) match.classList.add('active');
      }
      renderNavButtons();
    });

    // Step 2: preset amounts
    qsa('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const amt = Number(btn.dataset.amount);
        state.amount = amt;
        qs('#amount').value = String(amt);
        qsa('.preset-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        renderNavButtons();
      });
    });

    // Step 2: pledge calculator
    function updatePledgeAmount() {
      const income = state.pledgeIncome;
      const pct = state.pledgePct;
      if (income && pct) {
        state.amount = Math.round((income * pct / 100 / 12) * 100) / 100;
        qs('#pledgeResult').textContent =
          `That's ${getCurrencySymbol(state.currency)}${state.amount.toLocaleString()} per month.`;
      } else {
        state.amount = null;
        qs('#pledgeResult').textContent = '';
      }
      renderNavButtons();
    }

    qs('#pledgeIncome').addEventListener('input', (e) => {
      state.pledgeIncome = e.target.value ? Number(e.target.value) : null;
      updatePledgeAmount();
    });

    qsa('[name="pledge-pct"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.pledgePct = Number(radio.value);
        updatePledgeAmount();
      });
    });

    // Step 3: HLI percentage
    const hliCustomInput = qs('#hliCustomInput');
    const hliCustomPct = qs('#hliCustomPct');
    const hliCustomToggle = qs('#hliCustomToggle');

    qsa('[name="hli-pct"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.hliPct = Number(radio.value);
        renderImpact();
      });
    });

    hliCustomToggle.addEventListener('change', () => {
      if (hliCustomToggle.checked) {
        hliCustomInput.style.display = 'block';
        qsa('[name="hli-pct"]').forEach((r) => { r.checked = false; });
        hliCustomPct.focus();
      } else {
        hliCustomInput.style.display = 'none';
        hliCustomPct.value = '';
        // restore the 10% default
        const defaultRadio = qs('[name="hli-pct"][value="10"]');
        if (defaultRadio) { defaultRadio.checked = true; }
        state.hliPct = 10;
        renderImpact();
      }
    });

    hliCustomPct.addEventListener('input', () => {
      const raw = Number(hliCustomPct.value);
      state.hliPct = Math.min(100, Math.max(0, isNaN(raw) ? 0 : raw));
      renderImpact();
    });

    // Step 3: charity sliders
    charities.forEach((c) => {
      const slider = qs(`#range-${c.id}`);
      const label = qs(`#pct-${c.id}`);
      if (!slider) return;
      slider.addEventListener('input', () => {
        const val = Number(slider.value);
        state.splits[c.id] = val;
        label.textContent = `${val}%`;
        renderSplitTotals();
        renderImpact();
      });
    });

    // Step 4: donor fields
    ['firstName', 'lastName', 'email'].forEach((id) => {
      qs(`#${id}`)?.addEventListener('input', (e) => {
        state.donor[id] = e.target.value;
        renderNavButtons();
      });
    });

    qs('#country').addEventListener('change', (e) => {
      state.donor.country = e.target.value;
      const giftAidSection = qs('#giftAidSection');
      if (e.target.value === 'GB') {
        giftAidSection.removeAttribute('hidden');
      } else {
        giftAidSection.setAttribute('hidden', '');
        qs('#giftAid').checked = false;
        state.donor.giftAid = false;
      }
    });

    qs('#giftAid').addEventListener('change', (e) => {
      state.donor.giftAid = e.target.checked;
    });

    qs('#anonymous').addEventListener('change', (e) => {
      state.donor.anonymous = e.target.checked;
    });

    // Back / Next
    qs('#btnBack').addEventListener('click', () => {
      if (state.step === 5) teardownPaymentElement();
      const prev = prevStep();
      if (prev) goToStep(prev);
    });

    qs('#btnNext').addEventListener('click', () => {
      if (!isStepValid()) {
        highlightErrors();
        return;
      }
      if (state.step === 3) normalizeSplits();
      const next = nextStep();
      if (next) goToStep(next);
    });

    // Pay button
    qs('#payBtn').addEventListener('click', () => submitPayment());

    // Retry button (shown if API call fails)
    qs('#retryBtn').addEventListener('click', () => initPaymentElement());

    // Prevent info-btn clicks inside option-card labels from triggering radio selection
    qsa('.option-card .info-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => e.stopPropagation());
    });

    // Tooltips
    initTooltips();
  }

  // ── Tooltips ──────────────────────────────────────────────────────────────
  function initTooltips() {
    const popup = qs('#tooltipPopup');
    const textEl = qs('#tooltipText');
    let hideTimer;

    function show(btn) {
      clearTimeout(hideTimer);
      textEl.textContent = btn.dataset.tooltip;
      popup.removeAttribute('hidden');
      const rect = btn.getBoundingClientRect();
      const scrollY = window.scrollY;
      popup.style.top = `${rect.bottom + scrollY + 8}px`;
      popup.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - 300))}px`;
    }

    function hide() {
      hideTimer = setTimeout(() => popup.setAttribute('hidden', ''), 150);
    }

    document.addEventListener('mouseover', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
      else if (!popup.contains(e.target)) hide();
    });

    document.addEventListener('focusin', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
    });

    document.addEventListener('focusout', (e) => {
      if (!e.relatedTarget?.closest?.('#tooltipPopup')) hide();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') popup.setAttribute('hidden', '');
    });

    popup.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    popup.addEventListener('mouseleave', hide);
  }

  // ── Error highlighting ────────────────────────────────────────────────────
  function highlightErrors() {
    if (state.step === 1) {
      qs('.option-list').classList.add('shake');
      setTimeout(() => qs('.option-list').classList.remove('shake'), 500);
    }
    if (state.step === 2) {
      qs('#amount').classList.add('error');
      setTimeout(() => qs('#amount').classList.remove('error'), 2000);
    }
    if (state.step === 4) {
      ['firstName', 'lastName', 'email'].forEach((id) => {
        const el = qs(`#${id}`);
        if (!el?.value.trim() || (id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value))) {
          el?.classList.add('error');
          setTimeout(() => el?.classList.remove('error'), 2000);
        }
      });
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  async function init() {
    await loadFxRates();
    renderProgress();
    renderNavButtons();
    updateCurrencySymbol();
    renderSplitTotals();
    initEvents();
  }

  document.addEventListener('DOMContentLoaded', () => init());
</script>

<style>
  /* ── Layout ── */
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 24px 16px 0;
  }

  /* ── Header ── */
  .page-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .header-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    border-left: 1px solid var(--color-border);
    padding-left: 12px;
  }

  /* ── Progress bar ── */
  .progress-nav {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    margin-bottom: 24px;
  }

  :global(.prog-step) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 60px;
  }

  :global(.prog-circle) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--color-white);
    color: var(--color-text-secondary);
    transition: var(--transition);
  }

  :global(.prog-step.done .prog-circle) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  :global(.prog-step.current .prog-circle) {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  :global(.prog-label) {
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    text-align: center;
    white-space: nowrap;
  }

  :global(.prog-step.current .prog-label) {
    color: var(--color-primary);
    font-weight: 600;
  }

  :global(.prog-line) {
    flex: 1;
    height: 2px;
    background: var(--color-white);
    margin-top: 15px;
    min-width: 20px;
    transition: var(--transition);
  }

  :global(.prog-line.done) {
    background: var(--color-primary);
  }

  /* ── Form card ── */
  .form-card {
    background: var(--color-white);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  /* ── Steps ── */
  .step {
    display: none;
    opacity: 0;
    padding: 32px;
    transform: translateY(6px);
  }

  .step.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .step.leaving {
    display: block;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .step.entering {
    display: block;
    opacity: 0;
    transform: translateY(6px);
  }

  .step-title {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
    line-height: 1.25;
  }

  .step-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  /* ── Option cards (Step 1) ── */
  .option-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .option-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
    position: relative;
  }

  .option-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .option-card.selected {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .option-radio {
    position: absolute;
    opacity: 0;
