    display: flex;
    gap: 6px;
    align-items: flex-end;
  }

  .step-pill {
    flex: 1;
    cursor: pointer;
    display: block;
  }

  .step-pill-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .step-pill-wrapper .step-pill {
    flex: none;
    width: 100%;
  }

  .step-pill input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
  }

  .step-pill span {
    display: block;
    text-align: center;
    padding: 6px 4px;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-white);
    transition: all var(--transition);
    cursor: pointer;
    white-space: nowrap;
    width: 100%;
    box-sizing: border-box;
  }

  .step-pill input[type="radio"]:checked + span {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .hli-custom-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    cursor: pointer;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .hli-custom-toggle input[type="checkbox"] {
    accent-color: var(--color-primary);
    width: 14px;
    height: 14px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .hli-custom-input {
    display: none;
    margin-top: 8px;
  }

  .hli-custom-input input {
    width: 100%;
    padding: 8px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: 16px;
    color: var(--color-text);
    background: var(--color-white);
    box-sizing: border-box;
  }

  .hli-custom-input input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .hli-contrib-amount {
    margin: 10px 0 0;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .hli-contrib-amount strong {
    color: var(--color-primary);
  }

  .hli-contrib-subnote {
    margin: 10px 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .hli-contrib-fee-note {
    font-style: italic;
  }

  /* ── Charity picker cards (Step 3) ── */
  .charity-group-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 12px;
  }

  .charity-picker-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .charity-picker-grid {
      grid-template-columns: 1fr;
    }
  }

  .charity-picker-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .charity-picker-card:has(.charity-add-btn.added) {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .charity-picker-logo {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
  }

  .charity-picker-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-white);
    padding: 4px;
    box-sizing: border-box;
  }

  .charity-picker-logo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .charity-picker-body {
    flex: 1;
    min-width: 0;
  }

  .charity-picker-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .charity-picker-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0 0 6px;
  }

  .charity-picker-report-link {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: 8px;
  }

  .charity-picker-report-link:hover {
    text-decoration: underline;
  }

  .charity-picker-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  :global(.charity-picker-stat-value) {
    color: var(--color-primary);
    font-weight: 800;
  }

  .charity-add-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition);
  }

  .charity-add-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .charity-add-btn.added {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .charity-add-icon {
    width: 18px;
    height: 18px;
  }

  .charity-add-icon--check {
    display: none;
  }

  .charity-add-btn.added .charity-add-icon--plus {
    display: none;
  }

  .charity-add-btn.added .charity-add-icon--check {
    display: block;
  }

  /* ── Charity sliders (Step 3) ── */
  .allocation-title {
    margin-top: 8px;
    margin-bottom: 20px;
  }

  .charity-splits {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .charity-splits:empty {
    margin-bottom: 0;
  }

  .allocation-empty-hint {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0 0 32px;
  }

  :global(.charity-slider-row) {
    display: grid;
    grid-template-columns: 130px 1fr 48px auto;
    align-items: center;
    gap: 14px;
  }

  @media (max-width: 720px) {
    :global(.charity-slider-row) {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }
  }

  :global(.charity-info) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 4px;
    min-width: 0;
  }

  :global(.charity-name) {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  :global(.charity-tier-badge) {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 20px;
    line-height: 1.4;
    vertical-align: middle;
  }

  :global(.charity-tier-badge--top) {
    background: #2d6040;
    color: #ffffff;
  }

  :global(.charity-tier-badge--promising) {
    background: #c17f3a;
    color: #ffffff;
  }

  :global(.charity-pct-label) {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-primary);
    text-align: right;
  }

  :global(.charity-lock-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 10px;
    min-height: 44px;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-white);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition);
    flex-shrink: 0;
    box-sizing: border-box;
  }

  :global(.charity-lock-btn:hover) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  :global(.charity-lock-btn.locked) {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  :global(.charity-lock-icon) {
    width: 13px;
    height: 13px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  :global(.charity-lock-icon--closed) {
    display: none;
  }

  :global(.charity-lock-btn.locked .charity-lock-icon--open) {
    display: none;
  }

  :global(.charity-lock-btn.locked .charity-lock-icon--closed) {
    display: block;
  }

  :global(.charity-range) {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--color-border);
    border-radius: 3px;
    cursor: pointer;
    accent-color: var(--color-primary);
  }

  :global(.charity-range::-webkit-slider-thumb) {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 1px 4px rgba(28, 58, 94, 0.3);
    transition: transform var(--transition);
  }

  :global(.charity-range::-webkit-slider-thumb:hover) {
    transform: scale(1.15);
  }

  :global(.charity-range::-moz-range-thumb) {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    border: none;
    cursor: pointer;
  }

  /* ── Adjust amount (collapsible, Step 3) ── */
  .adjust-amount-details {
    background: var(--color-primary-light);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius);
    margin-top: 24px;
    margin-bottom: 24px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
  }

  .adjust-amount-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 16px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .adjust-amount-summary::-webkit-details-marker {
    display: none;
  }

  .adjust-amount-chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-text-secondary);
    transition: transform var(--transition);
  }

  .adjust-amount-details[open] .adjust-amount-chevron {
    transform: rotate(180deg);
  }

  .adjust-amount-body {
    padding: 0 16px 16px;
  }

  .freq-toggle--compact {
    margin-top: 0;
  }

  .boost-slider-row {
    margin-top: 20px;
  }

  .boost-slider-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .boost-slider-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .boost-slider-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .boost-slider-track-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .boost-slider-range-label {
    flex-shrink: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  :global(.boost-slider) {
    flex: 1;
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--color-primary);
    border-radius: 3px;
    cursor: pointer;
    accent-color: var(--color-primary);
  }

  :global(.boost-slider::-webkit-slider-thumb) {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-primary);
    box-shadow: 0 1px 4px rgba(28, 58, 94, 0.35);
    transition: transform var(--transition);
  }

  :global(.boost-slider::-webkit-slider-thumb:hover) {
    transform: scale(1.15);
  }

  :global(.boost-slider::-moz-range-thumb) {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-primary);
    cursor: pointer;
  }

  /* ── Impact card (Step 3) ── */
  .impact-card {
    padding: 16px 0 4px;
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .impact-timeframe {
    margin-bottom: 16px;
  }

  .stepped-selector--timeframe {
    max-width: 360px;
    margin: 0 auto;
  }

  .impact-age-input {
    margin-top: 10px;
    max-width: 240px;
    margin-left: auto;
    margin-right: auto;
  }

  .impact-age-input input {
    width: 100%;
    height: 42px;
    padding: 0 12px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    text-align: center;
    box-sizing: border-box;
  }

  .impact-age-input input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .impact-header-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 16px;
  }

  .impact-heading {
    font-size: 0.9375rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .impact-metrics-box {
    background: var(--color-primary-light);
    border-radius: var(--radius);
    padding: 20px;
  }

  .impact-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4px;
    margin-bottom: 12px;
  }

  .impact-metrics--two {
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-bottom: 0;
  }

  .impact-equals {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    padding: 0 12px;
  }

  .impact-context-card {
    background: var(--color-primary-light);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    margin-top: 12px;
  }

  .impact-metric {
    padding: 8px 4px;
  }


  .impact-number-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 6px;
  }

  .impact-number {
    font-size: clamp(1.5rem, 4.5vw, 2.125rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .impact-desc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .impact-desc--wrap {
    white-space: normal;
    text-align: center;
  }

  .impact-desc :global(.info-btn) {
    padding: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 400px) {
    .impact-desc {
      font-size: 0.75rem;
    }
  }

  .impact-delta {
    position: absolute;
    top: -2px;
    left: 100%;
    margin-left: 4px;
    font-size: 1rem;
    font-weight: 700;
    color: #1a9e4f;
    white-space: nowrap;
  }

  .impact-delta[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    .impact-delta {
      position: static;
      display: block;
      margin-left: 0;
      font-size: 0.875rem;
    }
  }

  .impact-number--conf {
    font-size: clamp(0.875rem, 2.5vw, 1.0625rem);
    font-weight: 700;
  }

  .impact-breakdown-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-align: left;
    margin: 20px 0 8px;
  }

  .impact-breakdown {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    row-gap: 4px;
  }

  :global(.impact-bk-row) {
    display: contents;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  :global(.impact-bk-name) {
    text-align: left;
    padding-left: 8px;
  }

  :global(.impact-bk-delta) {
    min-width: 2.5em;
    padding-right: 6px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  :global(.impact-bk-value) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-primary);
    font-weight: 800;
  }

  :global(.impact-bk-label) {
    text-align: left;
    padding-left: 6px;
    white-space: nowrap;
  }

  :global(.impact-bk-delta) {
    color: #1a9e4f;
    font-weight: 800;
  }

  :global(.impact-hint) {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-align: left;
    white-space: nowrap;
  }

  /* ── Outcome cards (Step 3) ── */
  .outcome-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 12px;
  }

  :global(.outcome-card) {
    background: var(--color-primary-light);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 14px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  :global(.outcome-icon) {
    width: 28px;
    height: 28px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  :global(.outcome-number) {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  :global(.outcome-label) {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  @media (max-width: 520px) {
    .outcome-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Form fields (Step 4) ── */
  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 16px;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .form-group input,
  .form-group select {
    height: 46px;
    padding: 0 12px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 16px;
    transition: border-color var(--transition);
    background: var(--color-white);
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group input.error {
    border-color: var(--color-error);
  }

  .field-optional {
    font-weight: 400;
    color: var(--color-text-secondary);
    opacity: 0.75;
  }

  .field-note {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .country-combobox {
    position: relative;
  }

  .country-options {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 240px;
    overflow-y: auto;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    z-index: 20;
  }

  .country-options li {
    padding: 8px 10px;
    border-radius: var(--radius-xs);
    font-size: 0.9375rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .country-options li:hover,
  .country-options li.active {
    background: var(--color-primary-light);
  }

  /* ── Gift Aid card (Step 4) ── */
  .gift-aid-card {
    background: var(--color-bg-card);
    border: 1.5px solid var(--color-yellow);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
  }

  .gift-aid-header {
    margin-bottom: 6px;
    font-size: 0.9375rem;
  }

  .gift-aid-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  /* ── Checkbox labels ── */
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  /* ── Review (Step 5) ── */
  .review-summary {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 20px;
  }

  :global(.review-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
