---
import BaseLayout from '../layouts/BaseLayout.astro';
import { charities, donationOptions } from '../data/charities';
import { currencies, defaultCurrency } from '../data/currencies';
---

<BaseLayout
  title="Donate | Happier Lives Institute"
  description="Give to the world's most cost-effective wellbeing charities. Choose the Happier Lives Fund or split your donation between our recommended charities."
>
  <main class="page">

    <!-- Header -->
    <header class="page-header">
      <a href="https://happierlivesinstitute.org" target="_blank" rel="noopener" aria-label="Happier Lives Institute homepage">
        <img src="/images/hli-logo.png" alt="Happier Lives Institute" class="logo" width="160" height="48" />
      </a>
      <p class="header-subtitle">Donation Portal</p>
    </header>

    <!-- Progress bar (rendered by JS) -->
    <nav class="progress-nav" id="progressNav" aria-label="Donation steps"></nav>

    <!-- Form card -->
    <div class="form-card">

      <!-- ── Step 1: Destination ── -->
      <section class="step active" id="step-1" aria-labelledby="step1-title">
        <h2 id="step1-title" class="step-title">Where would you like to give?</h2>
        <p class="step-desc">Each option reflects HLI's latest research on wellbeing impact.</p>

        <div class="option-list" role="radiogroup" aria-labelledby="step1-title">
          {donationOptions.map((opt) => (
            <label class="option-card" for={`dest-${opt.id}`}>
              <input
                type="radio"
                id={`dest-${opt.id}`}
                name="destination"
                value={opt.id}
                class="option-radio"
              />
              <div class="option-body">
                <div class="option-header-row">
                  <span class="option-name">{opt.name}</span>
                  {opt.recommended && <span class="badge-recommended">Recommended</span>}
                  <button
                    type="button"
                    class="info-btn"
                    aria-label={`More about ${opt.name}`}
                    data-tooltip={opt.description}
                  >ⓘ</button>
                </div>
                <p class="option-tagline">{opt.tagline}</p>
              </div>
              <span class="option-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </section>

      <!-- ── Step 2: Amount ── -->
      <section class="step" id="step-2" aria-labelledby="step2-title">
        <h2 id="step2-title" class="step-title">How much would you like to give?</h2>

        <div class="freq-toggle" role="group" aria-label="Donation frequency">
          <button type="button" class="freq-btn active" data-freq="one-off">One-time</button>
          <button type="button" class="freq-btn" data-freq="monthly">Monthly</button>
        </div>

        <div class="amount-row">
          <div class="currency-wrapper">
            <select id="currency" aria-label="Currency">
              {currencies.map((c) => (
                <option value={c.code} selected={c.code === defaultCurrency}>
                  {c.code} {c.symbol}
                </option>
              ))}
            </select>
          </div>
          <div class="amount-input-wrapper">
            <span class="amount-symbol" id="currencySymbol">$</span>
            <input
              type="number"
              id="amount"
              placeholder="0"
              min="1"
              step="1"
              aria-label="Donation amount"
            />
          </div>
        </div>

        <div class="preset-amounts" aria-label="Preset amounts">
          {[25, 50, 100, 250, 500, 1000].map((n) => (
            <button type="button" class="preset-btn" data-amount={n}>{n}</button>
          ))}
        </div>

        <p class="amount-note" id="amountNote"></p>
      </section>

      <!-- ── Step 3: Split (Recommended Charities only) ── -->
      <section class="step" id="step-3" aria-labelledby="step3-title">
        <h2 id="step3-title" class="step-title">How would you like to split your donation?</h2>
        <p class="step-desc">Adjust the sliders to divide your gift between the charities.</p>

        <!-- HLI contribution stepped selector -->
        <div class="hli-contrib-card">
          <div class="hli-contrib-header">
            <span class="hli-contrib-label">Contribution to HLI's research</span>
            <button
              type="button"
              class="info-btn"
              aria-label="More about the HLI contribution"
              data-tooltip="HLI is the research organisation behind these recommendations. A small contribution to HLI helps fund the rigorous work that identifies high-impact opportunities."
            >ⓘ</button>
          </div>
          <div class="stepped-selector" role="radiogroup" aria-label="HLI percentage">
            {[0, 5, 10, 15, 25].map((pct) => (
              <label class={`step-pill${pct === 10 ? ' recommended' : ''}`}>
                <input type="radio" name="hli-pct" value={pct} checked={pct === 10} />
                <span>{pct}%{pct === 10 ? <em> rec.</em> : ''}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Charity split sliders -->
        <div class="charity-splits" id="charitySplits">
          {charities.map((c, i) => (
            <div class="charity-slider-row" data-charity-id={c.id}>
              <div class="charity-slider-header">
                <div class="charity-info">
                  <span class="charity-name">{c.name}</span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label={`More about ${c.name}`}
                    data-tooltip={c.fullDescription}
                  >ⓘ</button>
                </div>
                <span class="charity-pct-label" id={`pct-${c.id}`}>25%</span>
              </div>
              <input
                type="range"
                class="charity-range"
                id={`range-${c.id}`}
                min="0"
                max="100"
                value="25"
                step="1"
                aria-label={`${c.name} percentage`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="25"
              />
            </div>
          ))}
        </div>

        <div class="split-total" id="splitTotal">
          <span>Total: </span><span id="splitTotalPct">100%</span>
          <span class="split-total-note" id="splitTotalNote"></span>
        </div>

        <!-- Impact calculator -->
        <div class="impact-card">
          <div class="impact-header-row">
            <span class="impact-heading">Estimated impact</span>
            <button
              type="button"
              class="info-btn"
              aria-label="About this estimate"
              data-tooltip="Based on HLI's WELLBY research. Each figure represents the estimated years of depression averted per dollar. These are best-evidence estimates and will be updated as research evolves."
            >ⓘ</button>
          </div>
          <div class="impact-number" id="impactNumber">—</div>
          <div class="impact-desc">years of depression averted</div>
          <div class="impact-breakdown" id="impactBreakdown"></div>
        </div>
      </section>

      <!-- ── Step 4: About you ── -->
      <section class="step" id="step-4" aria-labelledby="step4-title">
        <h2 id="step4-title" class="step-title">About you</h2>
        <p class="step-desc">We need a few details to process your donation and send you a receipt.</p>

        <div class="form-row-2">
          <div class="form-group">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" autocomplete="given-name" required />
          </div>
          <div class="form-group">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" autocomplete="family-name" required />
          </div>
        </div>

        <div class="form-group">
          <label for="email">Email address</label>
          <input type="email" id="email" autocomplete="email" required />
        </div>

        <div class="form-group">
          <label for="country">Country</label>
          <select id="country" autocomplete="country">
            <option value="">Select country…</option>
            <option value="GB">United Kingdom</option>
            <option value="US">United States</option>
            <option value="AU">Australia</option>
            <option value="CA">Canada</option>
            <option value="NZ">New Zealand</option>
            <option value="IE">Ireland</option>
            <option value="DE">Germany</option>
            <option value="FR">France</option>
            <option value="NL">Netherlands</option>
            <option value="SE">Sweden</option>
            <option value="NO">Norway</option>
            <option value="DK">Denmark</option>
            <option value="CH">Switzerland</option>
            <option value="AT">Austria</option>
            <option value="BE">Belgium</option>
            <option value="FI">Finland</option>
            <option value="SG">Singapore</option>
            <option value="HK">Hong Kong</option>
            <option value="JP">Japan</option>
            <option value="IN">India</option>
            <option value="ZA">South Africa</option>
            <option value="OTHER">Other</option>
          </select>
        </div>

        <!-- Gift Aid (UK only) -->
        <div class="gift-aid-card" id="giftAidSection" hidden>
          <div class="gift-aid-header">
            <strong>Boost your donation by 25% at no extra cost</strong>
          </div>
          <p class="gift-aid-desc">
            If you're a UK taxpayer, HLI can reclaim Gift Aid on your donation.
            This means your gift is worth 25% more at no cost to you.
          </p>
          <label class="checkbox-label">
            <input type="checkbox" id="giftAid" />
            <span>
              I am a UK taxpayer and I understand that if I pay less Income Tax and/or Capital
              Gains Tax in the current tax year than the amount of Gift Aid claimed on all my
              donations, it is my responsibility to pay any difference.
            </span>
          </label>
        </div>

        <label class="checkbox-label anonymous-label">
          <input type="checkbox" id="anonymous" />
          <span>Keep my donation anonymous</span>
        </label>
      </section>

      <!-- ── Step 5: Review ── -->
      <section class="step" id="step-5" aria-labelledby="step5-title">
        <h2 id="step5-title" class="step-title">Review your donation</h2>

        <div class="review-summary" id="reviewSummary">
          <!-- Populated by JS -->
        </div>

        <div class="trust-signals">
          <div class="trust-signal">
            <span class="trust-icon">🔒</span>
            <span>Secure payment via Stripe</span>
          </div>
          <div class="trust-signal">
            <span class="trust-icon">✓</span>
            <span>No percentage taken from programme donations</span>
          </div>
          <div class="trust-signal">
            <span class="trust-icon">📊</span>
            <span>
              <a href="https://happierlivesinstitute.org/transparency" target="_blank" rel="noopener">
                Full financial transparency
              </a>
            </span>
          </div>
        </div>

        <button type="button" class="btn-complete" id="completeBtn">
          Complete Donation →
        </button>
        <!-- TODO: Wire up to Stripe Checkout. See CLAUDE.md for integration notes. -->
        <p class="stripe-note">You'll be taken to Stripe's secure checkout to complete your payment.</p>
      </section>

    </div><!-- /.form-card -->

    <!-- Navigation -->
    <div class="form-nav">
      <button type="button" class="btn btn-back" id="btnBack">← Back</button>
      <button type="button" class="btn btn-primary" id="btnNext">Continue →</button>
    </div>

    <!-- Tooltip overlay -->
    <div class="tooltip-popup" id="tooltipPopup" role="tooltip" aria-live="polite" hidden>
      <p id="tooltipText"></p>
    </div>

  </main>
</BaseLayout>

<!-- ════════════════════════════════════════════
     Client-side script
     ════════════════════════════════════════════ -->
<script define:vars={{ charities, currencies, defaultCurrency }}>
  // ── State ──────────────────────────────────────────────────────────────
  const state = {
    step: 1,
    destination: /** @type {'hlf'|'recommended'|'hli'|null} */ (null),
    frequency: 'one-off',
    currency: defaultCurrency,
    amount: null,
    hliPct: 10,
    splits: Object.fromEntries(charities.map((c) => [c.id, 25])),
    donor: { firstName: '', lastName: '', email: '', country: '', giftAid: false, anonymous: false },
  };

  // ── Step sequence ───────────────────────────────────────────────────────
  function getStepSequence() {
    return state.destination === 'recommended' ? [1, 2, 3, 4, 5] : [1, 2, 4, 5];
  }

  function stepLabel(n) {
    return { 1: 'Destination', 2: 'Amount', 3: 'Split', 4: 'Your details', 5: 'Review' }[n];
  }

  function nextStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx < seq.length - 1 ? seq[idx + 1] : null;
  }

  function prevStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx > 0 ? seq[idx - 1] : null;
  }

  // ── DOM helpers ─────────────────────────────────────────────────────────
  function qs(sel) { return document.querySelector(sel); }
  function qsa(sel) { return document.querySelectorAll(sel); }

  // ── Progress bar ────────────────────────────────────────────────────────
  function renderProgress() {
    const nav = qs('#progressNav');
    const seq = getStepSequence();
    const pos = seq.indexOf(state.step) + 1;
    const total = seq.length;

    nav.innerHTML = seq.map((stepNum, i) => {
      const done = i < seq.indexOf(state.step);
      const current = stepNum === state.step;
      const cls = done ? 'prog-step done' : current ? 'prog-step current' : 'prog-step';
      const label = stepLabel(stepNum);
      return `
        <div class="${cls}" aria-current="${current ? 'step' : 'false'}">
          <div class="prog-circle">${done ? '✓' : i + 1}</div>
          <div class="prog-label">${label}</div>
        </div>
        ${i < seq.length - 1 ? '<div class="prog-line' + (done ? ' done' : '') + '"></div>' : ''}
      `;
    }).join('');

    // Screen reader text
    nav.setAttribute('aria-label', `Step ${pos} of ${total}: ${stepLabel(state.step)}`);
  }

  // ── Step transitions ────────────────────────────────────────────────────
  function goToStep(n) {
    const current = qs(`.step.active`);
    const next = qs(`#step-${n}`);
    if (!next || current === next) return;

    current.classList.remove('active');
    current.classList.add('leaving');

    setTimeout(() => {
      current.classList.remove('leaving');
      state.step = n;
      next.classList.add('entering');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          next.classList.remove('entering');
          next.classList.add('active');
          renderProgress();
          renderNavButtons();
          onStepEnter(n);
        });
      });
    }, 220);
  }

  function onStepEnter(n) {
    if (n === 3) renderImpact();
    if (n === 5) renderReview();
  }

  // ── Nav buttons ─────────────────────────────────────────────────────────
  function renderNavButtons() {
    const btnBack = qs('#btnBack');
    const btnNext = qs('#btnNext');
    const seq = getStepSequence();
    const isFirst = seq[0] === state.step;
    const isLast = seq[seq.length - 1] === state.step;

    btnBack.style.visibility = isFirst ? 'hidden' : 'visible';
    btnNext.style.display = isLast ? 'none' : 'inline-flex';
  }

  // ── Validation ──────────────────────────────────────────────────────────
  function isStepValid() {
    switch (state.step) {
      case 1: return state.destination !== null;
      case 2: return state.amount !== null && state.amount > 0;
      case 3: return true; // auto-normalizes on advance
      case 4: {
        const { firstName, lastName, email } = state.donor;
        return firstName.trim() && lastName.trim() && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }
      default: return true;
    }
  }

  // ── Currency symbol ──────────────────────────────────────────────────────
  function getCurrencySymbol(code) {
    const c = currencies.find((x) => x.code === code);
    return c ? c.symbol : code;
  }

  function updateCurrencySymbol() {
    qs('#currencySymbol').textContent = getCurrencySymbol(state.currency);
    renderPresetLabels();
  }

  function renderPresetLabels() {
    qsa('.preset-btn').forEach((btn) => {
      const amt = Number(btn.dataset.amount);
      btn.textContent = amt >= 1000 ? `${amt}` : `${amt}`;
    });
  }

  // ── Impact calculator ────────────────────────────────────────────────────
  function renderImpact() {
    const amt = state.amount || 0;
    let years = 0;
    let breakdown = [];

    if (state.destination === 'hlf') {
      const hlf = charities.find(c => c.id === 'hlf') || { yearsPerDollar: 3 };
      years = amt * 3;
      breakdown = [{ name: 'Happier Lives Fund', years }];
    } else if (state.destination === 'recommended') {
      const charityAmt = amt * (1 - state.hliPct / 100);
      const totalPct = Object.values(state.splits).reduce((s, v) => s + v, 0);
      breakdown = charities.map((c) => {
        const pct = totalPct > 0 ? state.splits[c.id] / totalPct : 0;
        const charityYears = charityAmt * pct * c.yearsPerDollar;
        return { name: c.name, years: charityYears };
      }).filter((b) => b.years > 0);
      years = breakdown.reduce((s, b) => s + b.years, 0);
    }

    const numEl = qs('#impactNumber');
    const bkEl = qs('#impactBreakdown');

    if (years > 0) {
      numEl.textContent = years < 1
        ? years.toFixed(2)
        : years < 100
        ? years.toFixed(1)
        : Math.round(years).toLocaleString();
      bkEl.innerHTML = breakdown
        .map((b) => `<div class="impact-bk-row"><span>${b.name}</span><span>${b.years < 1 ? b.years.toFixed(2) : b.years.toFixed(1)} yrs</span></div>`)
        .join('');
    } else {
      numEl.textContent = '—';
      bkEl.innerHTML = '<p class="impact-hint">Enter an amount to see your impact.</p>';
    }
  }

  // ── Split sliders ────────────────────────────────────────────────────────
  function renderSplitTotals() {
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);
    const el = qs('#splitTotalPct');
    const note = qs('#splitTotalNote');
    el.textContent = `${Math.round(total)}%`;
    if (Math.abs(total - 100) > 0.5) {
      el.style.color = 'var(--color-error)';
      note.textContent = `— will auto-adjust to 100% when you continue`;
    } else {
      el.style.color = 'var(--color-success)';
      note.textContent = '';
    }
  }

  function normalizeSplits() {
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);
    if (total === 0) {
      const eq = 100 / charities.length;
      charities.forEach((c) => { state.splits[c.id] = eq; });
    } else if (Math.abs(total - 100) > 0.5) {
      charities.forEach((c) => { state.splits[c.id] = (state.splits[c.id] / total) * 100; });
    }
    // Sync sliders to normalized values
    charities.forEach((c) => {
      const slider = qs(`#range-${c.id}`);
      const label = qs(`#pct-${c.id}`);
      if (slider) slider.value = String(Math.round(state.splits[c.id]));
      if (label) label.textContent = `${Math.round(state.splits[c.id])}%`;
    });
    renderSplitTotals();
    renderImpact();
  }

  // ── Review summary ────────────────────────────────────────────────────────
  function renderReview() {
    const sym = getCurrencySymbol(state.currency);
    const dest = state.destination === 'hlf'
      ? 'Happier Lives Fund'
      : state.destination === 'hli'
      ? 'Happier Lives Institute'
      : 'Recommended Charities';
    const freq = state.frequency === 'monthly' ? '/month' : ' one-time';
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);

    let splits = '';
    if (state.destination === 'recommended') {
      splits = `
        <div class="review-row"><span>HLI contribution</span><span>${state.hliPct}%</span></div>
        ${charities.map((c) => `
          <div class="review-row"><span>${c.name}</span><span>${Math.round(state.splits[c.id] / (total / 100))}%</span></div>
        `).join('')}
      `;
    }

    let impact = '';
    if (state.destination !== 'hli') {
      const amt = state.amount || 0;
      let years = state.destination === 'hlf' ? amt * 3 : 0;
      if (state.destination === 'recommended') {
        const charityAmt = amt * (1 - state.hliPct / 100);
        years = charities.reduce((s, c) => s + charityAmt * (state.splits[c.id] / (total || 100)) * c.yearsPerDollar, 0);
      }
      if (years > 0) {
        impact = `<div class="review-row impact-row"><span>Estimated impact</span><span>${years < 10 ? years.toFixed(1) : Math.round(years)} years of depression averted</span></div>`;
      }
    }

    qs('#reviewSummary').innerHTML = `
      <div class="review-row"><span>Giving to</span><span>${dest}</span></div>
      <div class="review-row"><span>Amount</span><span>${sym}${state.amount}${freq}</span></div>
      ${splits}
      ${impact}
      ${state.donor.giftAid ? '<div class="review-row"><span>Gift Aid</span><span>✓ Claimed</span></div>' : ''}
    `;
  }

  // ── Event listeners ───────────────────────────────────────────────────────
  function initEvents() {
    // Step 1: destination
    qsa('[name="destination"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.destination = radio.value;
        qsa('.option-card').forEach((c) => c.classList.remove('selected'));
        radio.closest('.option-card').classList.add('selected');
        renderNavButtons();
      });
    });

    // Step 2: frequency
    qsa('.freq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        qsa('.freq-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        state.frequency = btn.dataset.freq;
      });
    });

    // Step 2: currency
    qs('#currency').addEventListener('change', (e) => {
      state.currency = e.target.value;
      updateCurrencySymbol();
    });

    // Step 2: amount input
    qs('#amount').addEventListener('input', (e) => {
      state.amount = e.target.value ? Number(e.target.value) : null;
      qsa('.preset-btn').forEach((b) => b.classList.remove('active'));
      if (state.amount) {
        const match = qs(`.preset-btn[data-amount="${state.amount}"]`);
        if (match) match.classList.add('active');
      }
      renderNavButtons();
    });

    // Step 2: preset amounts
    qsa('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const amt = Number(btn.dataset.amount);
        state.amount = amt;
        qs('#amount').value = String(amt);
        qsa('.preset-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        renderNavButtons();
      });
    });

    // Step 3: HLI percentage
    qsa('[name="hli-pct"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.hliPct = Number(radio.value);
        renderImpact();
      });
    });

    // Step 3: charity sliders
    charities.forEach((c) => {
      const slider = qs(`#range-${c.id}`);
      const label = qs(`#pct-${c.id}`);
      if (!slider) return;
      slider.addEventListener('input', () => {
        const val = Number(slider.value);
        state.splits[c.id] = val;
        label.textContent = `${val}%`;
        renderSplitTotals();
        renderImpact();
      });
    });

    // Step 4: donor fields
    ['firstName', 'lastName', 'email'].forEach((id) => {
      qs(`#${id}`)?.addEventListener('input', (e) => {
        state.donor[id] = e.target.value;
        renderNavButtons();
      });
    });

    qs('#country').addEventListener('change', (e) => {
      state.donor.country = e.target.value;
      const giftAidSection = qs('#giftAidSection');
      if (e.target.value === 'GB') {
        giftAidSection.removeAttribute('hidden');
      } else {
        giftAidSection.setAttribute('hidden', '');
        qs('#giftAid').checked = false;
        state.donor.giftAid = false;
      }
    });

    qs('#giftAid').addEventListener('change', (e) => {
      state.donor.giftAid = e.target.checked;
    });

    qs('#anonymous').addEventListener('change', (e) => {
      state.donor.anonymous = e.target.checked;
    });

    // Back / Next
    qs('#btnBack').addEventListener('click', () => {
      const prev = prevStep();
      if (prev) goToStep(prev);
    });

    qs('#btnNext').addEventListener('click', () => {
      if (!isStepValid()) {
        highlightErrors();
        return;
      }
      if (state.step === 3) normalizeSplits();
      const next = nextStep();
      if (next) goToStep(next);
    });

    // Complete donation (placeholder)
    qs('#completeBtn').addEventListener('click', () => {
      alert('Stripe integration pending — see CLAUDE.md for implementation notes.');
    });

    // Tooltips
    initTooltips();
  }

  // ── Tooltips ──────────────────────────────────────────────────────────────
  function initTooltips() {
    const popup = qs('#tooltipPopup');
    const textEl = qs('#tooltipText');
    let hideTimer;

    function show(btn) {
      clearTimeout(hideTimer);
      textEl.textContent = btn.dataset.tooltip;
      popup.removeAttribute('hidden');
      const rect = btn.getBoundingClientRect();
      const scrollY = window.scrollY;
      popup.style.top = `${rect.bottom + scrollY + 8}px`;
      popup.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - 300))}px`;
    }

    function hide() {
      hideTimer = setTimeout(() => popup.setAttribute('hidden', ''), 150);
    }

    document.addEventListener('mouseover', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
      else if (!popup.contains(e.target)) hide();
    });

    document.addEventListener('focusin', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
    });

    document.addEventListener('focusout', (e) => {
      if (!e.relatedTarget?.closest?.('#tooltipPopup')) hide();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') popup.setAttribute('hidden', '');
    });

    popup.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    popup.addEventListener('mouseleave', hide);
  }

  // ── Error highlighting ────────────────────────────────────────────────────
  function highlightErrors() {
    if (state.step === 1) {
      qs('.option-list').classList.add('shake');
      setTimeout(() => qs('.option-list').classList.remove('shake'), 500);
    }
    if (state.step === 2) {
      qs('#amount').classList.add('error');
      setTimeout(() => qs('#amount').classList.remove('error'), 2000);
    }
    if (state.step === 4) {
      ['firstName', 'lastName', 'email'].forEach((id) => {
        const el = qs(`#${id}`);
        if (!el?.value.trim() || (id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value))) {
          el?.classList.add('error');
          setTimeout(() => el?.classList.remove('error'), 2000);
        }
      });
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  function init() {
    renderProgress();
    renderNavButtons();
    updateCurrencySymbol();
    renderSplitTotals();
  }

  document.addEventListener('DOMContentLoaded', init);
</script>

