---
import BaseLayout from '../layouts/BaseLayout.astro';
import { charities, donationOptions } from '../data/charities';
import { currencies, defaultCurrency } from '../data/currencies';
import { countries } from '../data/countries';

const stripePublishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ?? '';
---

<BaseLayout
  title="Donate | Happier Lives Institute"
  description="Give to the world's most cost-effective wellbeing charities. Choose the Happier Lives Fund or split your donation between our recommended charities."
>
  <main class="page">

    <!-- Header -->
    <header class="page-header">
      <a href="https://happierlivesinstitute.org" target="_blank" rel="noopener" aria-label="Happier Lives Institute homepage">
        <img src="/images/hli-logo-long.png" alt="Happier Lives Institute" class="logo" width="320" height="36" />
      </a>
    </header>

    <!-- Progress bar (rendered by JS) -->
    <nav class="progress-nav" id="progressNav" aria-label="Donation steps"></nav>

    <!-- Form card -->
    <div class="form-card">

      <!-- ── Step 1: Destination ── -->
      <section class="step active" id="step-1" aria-labelledby="step1-title">
        <h2 id="step1-title" class="step-title">Where would you like to give?</h2>
        <p class="step-desc">Each option reflects HLI's latest research on wellbeing impact.</p>

        <div class="option-list" role="radiogroup" aria-labelledby="step1-title">
          {donationOptions.map((opt) => (
            <label class="option-card" for={`dest-${opt.id}`}>
              <input
                type="radio"
                id={`dest-${opt.id}`}
                name="destination"
                value={opt.id}
                class="option-radio"
              />
              <div class="option-body">
                <div class="option-header-row">
                  <span class="option-name">{opt.name}</span>
                  {opt.recommended && <span class="badge-recommended">Recommended</span>}
                  <button
                    type="button"
                    class="info-btn"
                    aria-label={`More about ${opt.name}`}
                    data-tooltip={opt.description}
                  >ⓘ</button>
                </div>
                <p class="option-tagline">{opt.tagline}</p>
              </div>
              <span class="option-check" aria-hidden="true">✓</span>
            </label>
          ))}
        </div>
      </section>

      <!-- ── Step 2: Amount ── -->
      <section class="step" id="step-2" aria-labelledby="step2-title">
        <h2 id="step2-title" class="step-title">How much would you like to give?</h2>

        <div class="freq-toggle" role="group" aria-label="Donation frequency">
          <button type="button" class="freq-btn" data-freq="one-off">One-time</button>
          <button type="button" class="freq-btn active" data-freq="monthly">
            <span class="badge-recommended freq-btn-sticker">Most impactful</span>
            Monthly
            <span
              role="button"
              tabindex="0"
              class="info-btn freq-btn-info"
              aria-label="Why is monthly most impactful?"
              data-tooltip="Because we know what's coming in, monthly donations let us commit to longer-term research and give our charity partners the confidence to plan ahead"
            >ⓘ</span>
          </button>
          <!-- Pledge option temporarily disabled — code kept for later re-enable -->
          <button type="button" class="freq-btn freq-btn-pledge" data-freq="pledge" style="display:none;">
            Pledge
          </button>
        </div>

        <!-- Pledge entry point disabled for now — code kept for later re-enable
        <button type="button" class="pledge-redirect-link" id="pledgeRedirectLink">
          Want to give a percentage of your income? Take a pledge!
        </button>
        -->

        <div class="currency-wrapper">
          <select id="currency" aria-label="Currency">
            {currencies.map((c) => (
              <option value={c.code} selected={c.code === defaultCurrency}>
                {c.code} {c.symbol}
              </option>
            ))}
          </select>
        </div>

        <div id="manualAmountGroup">
          <div class="amount-row">
            <div class="amount-input-wrapper">
              <span class="amount-symbol" id="currencySymbol">$</span>
              <input
                type="number"
                id="amount"
                placeholder="0"
                min="1"
                step="1"
                aria-label="Donation amount"
              />
            </div>
          </div>

          <div class="preset-amounts" aria-label="Preset amounts" id="presetAmounts" data-freq="monthly">
            {[10, 25, 50, 100, 250, 500].map((n) => (
              <button type="button" class="preset-btn" data-amount={n}>{n}</button>
            ))}
          </div>

          <p class="amount-note" id="amountNote"></p>
        </div>

        <!-- HLF impact preview — shown only for the Happier Lives Fund path, which skips the Allocate step -->
        <div class="impact-card" id="hlfImpactCard" style="display:none;">
          <div class="impact-header-row">
            <span class="impact-heading">Estimated impact</span>
          </div>
          <div class="impact-timeframe" id="hlfImpactTimeframe" style="display:none;">
            <div class="stepped-selector stepped-selector--timeframe" role="radiogroup" aria-label="Impact timeframe">
              <label class="step-pill">
                <input type="radio" name="hlf-impact-timeframe" value="month" />
                <span>Per month</span>
              </label>
              <label class="step-pill">
                <input type="radio" name="hlf-impact-timeframe" value="year" checked />
                <span>Per year</span>
              </label>
              <label class="step-pill">
                <input type="radio" name="hlf-impact-timeframe" value="lifetime" />
                <span>Lifetime</span>
              </label>
            </div>
            <div class="impact-age-input" id="hlfImpactAgeInput" style="display:none;">
              <input
                type="number"
                id="hlfImpactAge"
                min="1"
                max="69"
                placeholder="Your current age"
                aria-label="Your current age"
              />
            </div>
          </div>
          <div class="impact-metrics-box">
            <div class="impact-metrics impact-metrics--two">
              <div class="impact-metric">
                <div class="impact-number" id="hlfImpactWellbys">—</div>
                <div class="impact-desc">
                  <span id="hlfImpactWellbysLabel">WELLBYs generated</span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label="About WELLBYs"
                    data-tooltip="WELLBYs (Wellbeing-Adjusted Life Years) measure the wellbeing impact of your donation using HLI's cost-per-WELLBY estimates."
                  >ⓘ</button>
                </div>
              </div>
              <span class="impact-equals" aria-hidden="true">=</span>
              <div class="impact-metric impact-metric--secondary">
                <div class="impact-number" id="hlfImpactDepressionYears">—</div>
                <div class="impact-desc">
                  <span id="hlfImpactDepressionYearsLabel">years of depression averted</span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label="About years of depression averted"
                    data-tooltip="Years of Depression Averted ≈ WELLBYs ÷ 1.3. The Happier Lives Fund allocates 10% to HLI's research and splits the remaining 90% between StrongMinds, Friendship Bench, Pure Earth, and Taimaka."
                  >ⓘ</button>
                </div>
              </div>
            </div>
          </div>
          <p class="impact-breakdown-label">Broken down by charity</p>
          <div class="impact-breakdown" id="hlfImpactBreakdown"></div>
        </div>

        <div id="pledgeCalculator" style="display:none;">
          <div class="amount-row">
            <div class="amount-input-wrapper">
              <span class="amount-symbol" id="pledgeCurrencySymbol">$</span>
              <input
                type="number"
                id="pledgeIncome"
                placeholder="Annual income"
                min="1"
                step="1"
                aria-label="Annual income"
              />
            </div>
          </div>

          <p class="pledge-pct-label">What % of your income would you like to pledge?</p>
          <div class="stepped-selector" role="radiogroup" aria-label="Pledge percentage">
            {[1, 3, 5, 10].map((pct) => (
              <label class="step-pill">
                <input type="radio" name="pledge-pct" value={pct} />
                <span>{pct}%</span>
              </label>
            ))}
          </div>

          <p class="pledge-result" id="pledgeResult"></p>
        </div>
      </section>

      <!-- ── Step 3: Split (Recommended Charities only) ── -->
      <section class="step" id="step-3" aria-labelledby="step3-title">
        <h2 id="step3-title" class="step-title">Choose one or more of our charities to support</h2>
        <p class="step-desc">Add the charity or charities you'd like to support. If you choose more than one, your gift will be divided equally between them, then you can fine-tune the amounts below.</p>

        <!-- Charity picker cards -->
        <div id="charityPickerGrid">
          <h3 class="charity-group-title">
            Top Charities
            <button
              type="button"
              class="info-btn"
              aria-label="What are Top Charities?"
              data-tooltip="These charities are amongst the most cost-effective at improving wellbeing, thoroughly investigated, and backed by strong evidence."
            >ⓘ</button>
          </h3>
          <div class="charity-picker-grid">
            {charities.filter((c) => c.tier === 'top').map((c) => (
              <div class="charity-picker-card" data-charity-id={c.id}>
                <div class="charity-picker-logo">
                  {c.logoUrl
                    ? <img
                        src={c.logoUrl}
                        alt={`${c.name} logo`}
                        style={c.logoZoom ? `transform: scale(${c.logoZoom});` : undefined}
                      />
                    : <span class="charity-picker-logo-fallback" aria-hidden="true">{c.name.charAt(0)}</span>
                  }
                </div>
                <div class="charity-picker-body">
                  <div class="charity-picker-name-row">
                    <span class="charity-name">{c.name}</span>
                    <span class={`charity-tier-badge charity-tier-badge--${c.tier}`}>
                      {c.tier === 'top' ? 'Top Charity' : 'Promising'}
                    </span>
                  </div>
                  <p class="charity-picker-desc">{c.fullDescription}</p>
                  <a
                    class="charity-picker-report-link"
                    href={c.reportUrl ?? c.website}
                    target="_blank"
                    rel="noopener"
                  >Read our report →</a>
                  <div class="charity-picker-stats">
                    <span class="charity-picker-stat" id={`effectiveness-${c.id}`}></span>
                  </div>
                </div>
                <button
                  type="button"
                  class="charity-add-btn"
                  id={`add-${c.id}`}
                  aria-pressed="false"
                  aria-label={`Add ${c.name} to your split`}
                >
                  <svg class="charity-add-icon charity-add-icon--plus" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/>
                  </svg>
                  <svg class="charity-add-icon charity-add-icon--check" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            ))}
          </div>

          <h3 class="charity-group-title">
            Promising Charities
            <button
              type="button"
              class="info-btn"
              aria-label="What are Promising Charities?"
              data-tooltip="These charities are likely extremely cost-effective based on research so far, however we need stronger evidence for them to qualify as a 'Top Recommended Charity'. They're higher risk, higher reward, in terms of cost-effectiveness compared to top charities."
            >ⓘ</button>
          </h3>
          <div class="charity-picker-grid">
            {charities.filter((c) => c.tier === 'promising').map((c) => (
              <div class="charity-picker-card" data-charity-id={c.id}>
                <div class="charity-picker-logo">
                  {c.logoUrl
                    ? <img
                        src={c.logoUrl}
                        alt={`${c.name} logo`}
                        style={c.logoZoom ? `transform: scale(${c.logoZoom});` : undefined}
                      />
                    : <span class="charity-picker-logo-fallback" aria-hidden="true">{c.name.charAt(0)}</span>
                  }
                </div>
                <div class="charity-picker-body">
                  <div class="charity-picker-name-row">
                    <span class="charity-name">{c.name}</span>
                    <span class={`charity-tier-badge charity-tier-badge--${c.tier}`}>
                      {c.tier === 'top' ? 'Top Charity' : 'Promising'}
                    </span>
                  </div>
                  <p class="charity-picker-desc">{c.fullDescription}</p>
                  <a
                    class="charity-picker-report-link"
                    href={c.reportUrl ?? c.website}
                    target="_blank"
                    rel="noopener"
                  >Read our report →</a>
                  <div class="charity-picker-stats">
                    <span class="charity-picker-stat" id={`effectiveness-${c.id}`}></span>
                  </div>
                </div>
                <button
                  type="button"
                  class="charity-add-btn"
                  id={`add-${c.id}`}
                  aria-pressed="false"
                  aria-label={`Add ${c.name} to your split`}
                >
                  <svg class="charity-add-icon charity-add-icon--plus" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/>
                  </svg>
                  <svg class="charity-add-icon charity-add-icon--check" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            ))}
          </div>
        </div>

        <h3 class="step-title allocation-title">Choose your allocation</h3>

        <!-- Charity split sliders — populated by JS as charities are added -->
        <div class="charity-splits" id="charitySplits"></div>
        <p class="allocation-empty-hint" id="allocationEmptyHint" hidden>Add some charities above first.</p>

        <!-- Adjust amount (collapsed by default) — lets donors tweak the amount here
             and immediately see the effect on the impact calculator below. -->
        <details class="adjust-amount-details" id="adjustAmountDetails">
          <summary class="adjust-amount-summary">
            See the impact of increasing your donation
            <svg class="adjust-amount-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="adjust-amount-body">
            <div class="freq-toggle freq-toggle--compact" role="group" aria-label="Donation frequency">
              <button type="button" class="freq-btn" data-freq="one-off">One-time</button>
              <button type="button" class="freq-btn active" data-freq="monthly">
                <span class="badge-recommended freq-btn-sticker">Most impactful</span>
                Monthly
              </button>
            </div>

            <div class="boost-slider-row" id="boostSliderRow">
              <div class="boost-slider-label-row">
                <span class="boost-slider-label">Boost your impact</span>
                <span class="boost-slider-value" id="boostSliderValue"></span>
              </div>
              <div class="boost-slider-track-row">
                <span class="boost-slider-range-label" id="boostSliderMinLabel"></span>
                <input
                  type="range"
                  class="boost-slider"
                  id="boostSlider"
                  min="0"
                  max="0"
                  step="1"
                  value="0"
                  aria-label="Increase your donation amount"
                />
                <span class="boost-slider-range-label" id="boostSliderMaxLabel"></span>
              </div>
            </div>
          </div>
        </details>

        <!-- Impact calculator -->
        <div class="impact-card">
          <div class="impact-header-row">
            <span class="impact-heading">Estimated impact</span>
          </div>
          <div class="impact-timeframe" id="impactTimeframe" style="display:none;">
            <div class="stepped-selector stepped-selector--timeframe" role="radiogroup" aria-label="Impact timeframe">
              <label class="step-pill">
                <input type="radio" name="impact-timeframe" value="month" />
                <span>Per month</span>
              </label>
              <label class="step-pill">
                <input type="radio" name="impact-timeframe" value="year" checked />
                <span>Per year</span>
              </label>
              <label class="step-pill">
                <input type="radio" name="impact-timeframe" value="lifetime" />
                <span>Lifetime</span>
              </label>
            </div>
            <div class="impact-age-input" id="impactAgeInput" style="display:none;">
              <input
                type="number"
                id="impactAge"
                min="1"
                max="69"
                placeholder="Your current age"
                aria-label="Your current age"
              />
            </div>
          </div>
          <div class="impact-metrics-box">
            <div class="impact-metrics impact-metrics--two">
              <div class="impact-metric">
                <div class="impact-number-wrap">
                  <div class="impact-number" id="impactWellbys">—</div>
                  <span class="impact-delta" id="impactWellbysDelta" hidden></span>
                </div>
                <div class="impact-desc">
                  <span id="impactWellbysLabel">WELLBYs generated</span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label="About WELLBYs"
                    data-tooltip="WELLBYs (Wellbeing-Adjusted Life Years) measure the wellbeing impact of your donation using HLI's cost-per-WELLBY estimates."
                  >ⓘ</button>
                </div>
              </div>
              <span class="impact-equals" aria-hidden="true">=</span>
              <div class="impact-metric impact-metric--secondary">
                <div class="impact-number-wrap">
                  <div class="impact-number" id="impactDepressionYears">—</div>
                  <span class="impact-delta" id="impactDepressionYearsDelta" hidden></span>
                </div>
                <div class="impact-desc">
                  <span id="impactDepressionYearsLabel">years of depression averted</span>
                  <button
                    type="button"
                    class="info-btn"
                    aria-label="About years of depression averted"
                    data-tooltip="Years of Depression Averted ≈ WELLBYs ÷ 1.3."
                  >ⓘ</button>
                </div>
              </div>
            </div>
          </div>
          <p class="impact-breakdown-label">Broken down by charity</p>
          <div class="impact-breakdown" id="impactBreakdown"></div>
        </div>

        <!-- HLI contribution stepped selector — moved to the bottom of the step -->
        <div class="hli-contrib-card">
          <div class="hli-contrib-header">
            <span class="hli-contrib-label">Contribution to HLI's research</span>
            <button
              type="button"
              class="info-btn"
              aria-label="More about the HLI contribution"
              data-tooltip="The Happier Lives Institute is on a mission to put wellbeing at the heart of decision making. We have big dreams to do more research, evaluate more charities and build better infrastructure for our donors, but currently we don't have the funding to achieve all our goals"
            >ⓘ</button>
          </div>
          <div class="stepped-selector" role="radiogroup" aria-label="HLI percentage">
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={0} />
              <span>0%</span>
            </label>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={5} />
              <span>5%</span>
            </label>
            <div class="step-pill-wrapper">
              <span class="badge-recommended">Recommended</span>
              <label class="step-pill">
                <input type="radio" name="hli-pct" value={10} checked />
                <span>10%</span>
              </label>
            </div>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={15} />
              <span>15%</span>
            </label>
            <label class="step-pill">
              <input type="radio" name="hli-pct" value={25} />
              <span>25%</span>
            </label>
          </div>
          <label class="hli-custom-toggle">
            <input type="checkbox" id="hliCustomToggle" />
            <span>Choose a custom %</span>
          </label>
          <div class="hli-custom-input" id="hliCustomInput">
            <input
              type="number"
              id="hliCustomPct"
              min="0"
              max="100"
              placeholder="Enter a percentage (0–100)"
            />
          </div>
          <p class="hli-contrib-amount" id="hliContribAmount"></p>
          <p class="hli-contrib-subnote hli-contrib-fee-note">
            This contribution is charged in addition to your donation and does not reduce the amount your chosen charities receive.
          </p>
        </div>
      </section>

      <!-- ── Step 4: About you ── -->
      <section class="step" id="step-4" aria-labelledby="step4-title">
        <h2 id="step4-title" class="step-title">About you</h2>
        <p class="step-desc">We need a few details to process your donation and send you a receipt.</p>

        <div class="form-row-2">
          <div class="form-group">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" autocomplete="given-name" required />
          </div>
          <div class="form-group">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" autocomplete="family-name" required />
          </div>
        </div>

        <div class="form-group">
          <label for="email">Email address</label>
          <input type="email" id="email" autocomplete="email" required />
        </div>

        <div class="form-group country-combobox" id="countryCombobox">
          <label for="country">Country</label>
          <input
            type="text"
            id="country"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="countryOptions"
            autocomplete="off"
            placeholder="Start typing a country…"
          />
          <ul class="country-options" id="countryOptions" role="listbox" hidden></ul>
        </div>

        <div class="form-group">
          <label for="addressLine1">Address line 1</label>
          <input type="text" id="addressLine1" autocomplete="address-line1" required />
          <p class="field-note" id="addressLine1Note" hidden>A UK address is required for Gift Aid.</p>
        </div>

        <div class="form-group">
          <label for="addressLine2">Address line 2 <span class="field-optional">(optional)</span></label>
          <input type="text" id="addressLine2" autocomplete="address-line2" placeholder="Apartment, suite, unit" />
        </div>

        <div class="form-group">
          <label for="city">City / Town</label>
          <input type="text" id="city" autocomplete="address-level2" required />
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="state" id="stateLabel">State / Province / Region <span class="field-optional" id="stateOptionalTag">(optional)</span></label>
            <input type="text" id="state" autocomplete="address-level1" />
          </div>
          <div class="form-group">
            <label for="postalCode">Postal / ZIP code <span class="field-optional" id="postalOptionalTag">(optional)</span></label>
            <input type="text" id="postalCode" autocomplete="postal-code" />
            <p class="field-note" id="postalCodeNote" hidden></p>
          </div>
        </div>

        <!-- Gift Aid (UK only) -->
        <div class="gift-aid-card" id="giftAidSection" hidden>
          <div class="gift-aid-header">
            <strong>Boost your donation by 25% at no extra cost</strong>
          </div>
          <p class="gift-aid-desc">
            If you're a UK taxpayer, HLI can reclaim Gift Aid on your donation.
            This means your gift is worth 25% more at no cost to you.
          </p>
          <label class="checkbox-label">
            <input type="checkbox" id="giftAid" />
            <span>
              I am a UK taxpayer and I understand that if I pay less Income Tax and/or Capital
              Gains Tax in the current tax year than the amount of Gift Aid claimed on all my
              donations, it is my responsibility to pay any difference.
            </span>
          </label>
        </div>
      </section>

      <!-- ── Step 5: Review ── -->
      <section class="step" id="step-5" aria-labelledby="step5-title">
        <h2 id="step5-title" class="step-title">Review your donation</h2>

        <div class="review-summary" id="reviewSummary">
          <!-- Populated by JS -->
        </div>

        <div class="monthly-upsell" id="monthlyUpsell" style="display:none;">
          <p>Make your donation monthly instead and build a giving habit! You can always alter the amount in our donor platform later</p>
          <button type="button" class="monthly-upsell-btn" id="monthlyUpsellBtn">Make it monthly</button>
        </div>

        <!-- Payment loading state -->
        <div id="paymentLoading" class="payment-loading">
          <div class="spinner"></div>
          <span>Preparing secure payment…</span>
        </div>

        <!-- Payment Element + pay button (shown once Stripe is ready) -->
        <div id="paymentArea" style="display:none;">
          <div id="payment-element"></div>
          <div id="paymentError" class="payment-error" style="display:none;" role="alert"></div>
          <button type="button" class="btn-complete" id="payBtn" disabled>
            Pay now →
          </button>
          <p class="stripe-note">Secured by Stripe · Your card details are never sent to our servers.</p>
        </div>

        <!-- Error state: shown if the API call fails entirely -->
        <div id="paymentInitError" class="payment-init-error" style="display:none;" role="alert">
          <p>We couldn't prepare your payment. Please check your connection and try again.</p>
          <button type="button" class="btn-retry" id="retryBtn">Try again</button>
          <button type="button" class="btn-complete mockup-pay-btn" id="mockupPayBtn">Pay with Stripe (mockup)</button>
        </div>
      </section>

    </div><!-- /.form-card -->

    <!-- Navigation -->
    <div class="form-nav">
      <button type="button" class="btn btn-back" id="btnBack">← Back</button>
      <button type="button" class="btn btn-primary" id="btnNext">Continue →</button>
    </div>

    <!-- Tooltip overlay -->
    <div class="tooltip-popup" id="tooltipPopup" role="tooltip" aria-live="polite" hidden>
      <p id="tooltipText"></p>
    </div>

  </main>
</BaseLayout>

<!-- ════════════════════════════════════════════
     Client-side script
     ════════════════════════════════════════════ -->
<script define:vars={{ charities, currencies, countries, defaultCurrency, stripePublishableKey }}>
  // ── State ──────────────────────────────────────────────────────────────
  const state = {
    step: 1,
    destination: /** @type {'hlf'|'recommended'|'hli'|null} */ (null),
    frequency: 'monthly',
    currency: defaultCurrency,
    amount: null,
    pledgeIncome: null,
    pledgePct: null,
    hliPct: 10,
    addedCharityIds: [],
    splits: {},
    splitLocks: {},
    impactTimeframe: 'year',
    impactAge: null,
    boostBaseline: null,
    donor: {
      firstName: '', lastName: '', email: '',
      country: '', countryCode: '',
      addressLine1: '', addressLine2: '', city: '', state: '', postalCode: '',
      giftAid: false, monthlyUpsellAccepted: false,
    },
  };

  // ── Step sequence ───────────────────────────────────────────────────────
  function getStepSequence() {
    return state.destination === 'recommended' ? [1, 2, 3, 4, 5] : [1, 2, 4, 5];
  }

  function stepLabel(n) {
    return { 1: 'Destination', 2: 'Amount', 3: 'Allocate', 4: 'Your details', 5: 'Review' }[n];
  }

  function nextStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx < seq.length - 1 ? seq[idx + 1] : null;
  }

  function prevStep() {
    const seq = getStepSequence();
    const idx = seq.indexOf(state.step);
    return idx > 0 ? seq[idx - 1] : null;
  }

  // ── DOM helpers ─────────────────────────────────────────────────────────
  function qs(sel) { return document.querySelector(sel); }
  function qsa(sel) { return document.querySelectorAll(sel); }

  // ── Progress bar ────────────────────────────────────────────────────────
  function renderProgress() {
    const nav = qs('#progressNav');
    const seq = getStepSequence();
    const pos = seq.indexOf(state.step) + 1;
    const total = seq.length;

    nav.innerHTML = seq.map((stepNum, i) => {
      const done = i < seq.indexOf(state.step);
      const current = stepNum === state.step;
      const cls = done ? 'prog-step done' : current ? 'prog-step current' : 'prog-step';
      const label = stepLabel(stepNum);
      const clickable = done;
      return `
        <div class="${cls}" aria-current="${current ? 'step' : 'false'}">
          ${clickable
            ? `<button type="button" class="prog-circle-btn" data-step="${stepNum}" aria-label="Go back to ${label}"><div class="prog-circle">✓</div></button>`
            : `<div class="prog-circle">${done ? '✓' : i + 1}</div>`}
          <div class="prog-label">${label}</div>
        </div>
        ${i < seq.length - 1 ? '<div class="prog-line' + (done ? ' done' : '') + '"></div>' : ''}
      `;
    }).join('');

    // Screen reader text
    nav.setAttribute('aria-label', `Step ${pos} of ${total}: ${stepLabel(state.step)}`);

    qsa('.prog-circle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (state.step === 5) teardownPaymentElement();
        goToStep(Number(btn.dataset.step));
      });
    });
  }

  // ── Step transitions ────────────────────────────────────────────────────
  function goToStep(n) {
    const current = qs(`.step.active`);
    const next = qs(`#step-${n}`);
    if (!next || current === next) return;

    current.classList.remove('active');
    current.classList.add('leaving');

    setTimeout(() => {
      current.classList.remove('leaving');
      state.step = n;
      next.classList.add('entering');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          next.classList.remove('entering');
          next.classList.add('active');
          renderProgress();
          renderNavButtons();
          onStepEnter(n);
        });
      });
    }, 220);
  }

  function onStepEnter(n) {
    document.body.classList.toggle('step-3-active', n === 3);
    if (n === 2) { fitAmountSymbol('currencySymbol'); fitAmountSymbol('pledgeCurrencySymbol'); renderHlfImpact(); }
    if (n === 3) renderImpact();
    if (n === 5) { renderReview(); initPaymentElement(); }
  }

  // ── Nav buttons ─────────────────────────────────────────────────────────
  function renderNavButtons() {
    const btnBack = qs('#btnBack');
    const btnNext = qs('#btnNext');
    const seq = getStepSequence();
    const isFirst = seq[0] === state.step;
    const isLast = seq[seq.length - 1] === state.step;

    btnBack.style.visibility = isFirst ? 'hidden' : 'visible';
    btnNext.style.display = isLast ? 'none' : 'inline-flex';
  }

  // ── Address requirements (vary by country) ────────────────────────────────
  const US_ZIP_RE = /^\d{5}(-\d{4})?$/;
  const CA_POSTAL_RE = /^[A-Za-z]\d[A-Za-z][ -]?\d[A-Za-z]\d$/;

  function addressRequirements(countryCode) {
    if (countryCode === 'GB') {
      return { addressLine1: true, city: true, state: false, postalCode: true };
    }
    if (countryCode === 'US' || countryCode === 'CA') {
      return { addressLine1: true, city: true, state: true, postalCode: true };
    }
    return { addressLine1: true, city: true, state: false, postalCode: false };
  }

  function postalCodeFormatValid(countryCode, value) {
    const trimmed = value.trim();
    if (countryCode === 'US') return US_ZIP_RE.test(trimmed);
    if (countryCode === 'CA') return CA_POSTAL_RE.test(trimmed);
    return true; // formats vary too much elsewhere — don't hard-block
  }

  // ── Validation ──────────────────────────────────────────────────────────
  function isStepValid() {
    switch (state.step) {
      case 1: return state.destination !== null;
      case 2: return state.amount !== null && state.amount > 0;
      case 3: return state.addedCharityIds.length > 0;
      case 4: {
        const { firstName, lastName, email, countryCode, addressLine1, city, state: region, postalCode } = state.donor;
        if (!firstName.trim() || !lastName.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          return false;
        }
        const req = addressRequirements(countryCode);
        if (req.addressLine1 && !addressLine1.trim()) return false;
        if (req.city && !city.trim()) return false;
        if (req.state && !region.trim()) return false;
        if (req.postalCode) {
          if (!postalCode.trim()) return false;
          if (!postalCodeFormatValid(countryCode, postalCode)) return false;
        }
        return true;
      }
      default: return true;
    }
  }

  // ── Currency symbol ──────────────────────────────────────────────────────
  function getCurrencySymbol(code) {
    const c = currencies.find((x) => x.code === code);
    return c ? c.symbol : code;
  }

  function fitAmountSymbol(symbolId) {
    const symbolEl = qs(`#${symbolId}`);
    const input = symbolEl?.parentElement?.querySelector('input');
    if (!symbolEl || !input) return;
    input.style.paddingLeft = `${symbolEl.offsetWidth + 22}px`;
  }

  function updateCurrencySymbol() {
    qs('#currencySymbol').textContent = getCurrencySymbol(state.currency);
    qs('#pledgeCurrencySymbol').textContent = getCurrencySymbol(state.currency);
    fitAmountSymbol('currencySymbol');
    fitAmountSymbol('pledgeCurrencySymbol');
    renderPresetLabels();
  }

  function renderPresetLabels() {
    qsa('.preset-btn').forEach((btn) => {
      const amt = Number(btn.dataset.amount);
      btn.textContent = amt >= 1000 ? `${amt}` : `${amt}`;
    });
  }

  // ── Exchange rates ────────────────────────────────────────────────────────
  let fxRates = {};

  async function loadFxRates() {
    try {
      const res  = await fetch('https://api.frankfurter.app/latest?base=USD');
      const data = await res.json();
      fxRates = data.rates ?? {};
      fxRates['USD'] = 1;
    } catch {
      fxRates = {};
    }
  }

  function toUSD(amount) {
    const rate = fxRates[state.currency];
    return rate ? amount / rate : amount;
  }

  // ── Impact calculator ────────────────────────────────────────────────────
  const fmt = (n) => n < 1 ? n.toFixed(2) : n < 100 ? n.toFixed(1) : Math.round(n).toLocaleString();
  const LIFETIME_END_AGE = 70;

  // Monthly donations show a per-month/per-year/lifetime toggle; the base
  // impact amount is always the per-donation (monthly) figure, so "year" and
  // "lifetime" scale it up. One-time donations always use a 1x multiplier —
  // the raw impact of that single gift.
  function impactMultiplier() {
    if (state.frequency !== 'monthly') return 1;
    if (state.impactTimeframe === 'year') return 12;
    if (state.impactTimeframe === 'lifetime') {
      const age = state.impactAge;
      if (!age || age >= LIFETIME_END_AGE) return 0;
      return (LIFETIME_END_AGE - age) * 12;
    }
    return 1;
  }

  function confidenceLabel(score) {
    if (score >= 9)        return { label: 'Very Low Risk',  color: '#1a4d2e' };
    if (score > 7.5)       return { label: 'Low Risk',       color: '#2d6040' };
    if (score >= 6.5)      return { label: 'Medium Risk',    color: '#c17f3a' };
    if (score >= 5)        return { label: 'High Risk',      color: '#c0392b' };
    return                        { label: 'Very High Risk', color: '#7b1c1c' };
  }

  function addedCharities() {
    return state.addedCharityIds.map((id) => charities.find((c) => c.id === id)).filter(Boolean);
  }

  function renderOutcomeCards() {
    const container = qs('#outcomeCards');
    if (!container) return;
    container.innerHTML = addedCharities()
      .map((c) => `
        <div class="outcome-card">
          <div class="outcome-number" id="outcome-${c.id}">—</div>
          <div class="outcome-label">${c.outcomeLabel}</div>
        </div>
      `)
      .join('');
  }

  function renderHliContribution() {
    const el = qs('#hliContribAmount');
    if (!el) return;
    const amt = state.amount || 0;
    const hliAmount = amt * (state.hliPct / 100);
    if (hliAmount <= 0) {
      el.textContent = '';
      return;
    }
    const sym = getCurrencySymbol(state.currency);
    const extraDepressionYears = toUSD(hliAmount) / 9.5;
    const isMonthly = state.frequency === 'monthly';
    const cadence = isMonthly ? ' per month' : '';
    const everyPeriod = isMonthly ? ' every month' : '';
    el.innerHTML = `<strong>${sym}${hliAmount.toFixed(2)}</strong>${cadence} — averts an estimated <strong>${fmt(extraDepressionYears)}</strong> additional year${extraDepressionYears === 1 ? '' : 's'} of depression${everyPeriod}`;
  }

  // Show/hide the Per month / Per year / Lifetime control (monthly donations
  // only) and its age input (Lifetime only), for a given card's element-id prefix.
  function syncTimeframeUI(timeframeId, ageWrapperId) {
    const wrapper = qs(`#${timeframeId}`);
    if (!wrapper) return;
    wrapper.style.display = state.frequency === 'monthly' ? '' : 'none';
    const ageWrapper = qs(`#${ageWrapperId}`);
    if (ageWrapper) ageWrapper.style.display = state.impactTimeframe === 'lifetime' ? '' : 'none';
  }

  // "WELLBYs generated" / "years of depression averted" gain a period suffix
  // matching the selected Per month / Per year / Lifetime tab, so the numbers
  // shown are clearly labelled as covering that period, not just scaled silently.
  function impactPeriodSuffix() {
    if (state.frequency !== 'monthly') return '';
    if (state.impactTimeframe === 'year') return ' per year';
    if (state.impactTimeframe === 'lifetime') return ' over your lifetime';
    return '/month';
  }

  function syncImpactLabels(prefix) {
    const suffix = impactPeriodSuffix();
    const wellbysEl = qs(`#${prefix}WellbysLabel`);
    const yearsEl = qs(`#${prefix}DepressionYearsLabel`);
    if (wellbysEl) wellbysEl.textContent = `WELLBYs generated${suffix}`;
    if (yearsEl) yearsEl.textContent = `years of depression averted${suffix}`;
    const shouldWrap = state.impactTimeframe === 'lifetime';
    const wellbysDesc = wellbysEl?.closest('.impact-desc');
    const yearsDesc = yearsEl?.closest('.impact-desc');
    wellbysDesc?.classList.toggle('impact-desc--wrap', shouldWrap);
    yearsDesc?.classList.toggle('impact-desc--wrap', shouldWrap);
  }

  // Pure calculator used by both the impact card and the boost-slider delta —
  // splitFractions: [{ costPerWellby, fraction }], fractions should sum to ~1.
  // Mirrors the math inside renderImpact() below.
  function calcWellbys(amountUSD, splitFractions) {
    return splitFractions.reduce(
      (sum, { costPerWellby, fraction }) => sum + (amountUSD * fraction) / costPerWellby, 0
    );
  }

  function currentSplitFractions() {
    const added = addedCharities();
    const totalSplits = added.reduce((s, c) => s + (state.splits[c.id] || 0), 0);
    return added.map((c) => ({
      costPerWellby: c.costPerWellby,
      fraction: totalSplits > 0 ? state.splits[c.id] / totalSplits : 0,
    }));
  }

  // "Boost your impact" slider (Change-amount section) — starts at whatever
  // state.amount currently is (the "baseline") and can only move upward from
  // there, so donors can't drag below the amount they already chose. The
  // baseline re-anchors to the current amount whenever it changes elsewhere
  // (number input, presets) so the slider always represents "boost from here."
  function refreshBoostSlider() {
    const slider = qs('#boostSlider');
    const row = qs('#boostSliderRow');
    const valueEl = qs('#boostSliderValue');
    const minLabelEl = qs('#boostSliderMinLabel');
    const maxLabelEl = qs('#boostSliderMaxLabel');
    if (!slider || !row || !valueEl) return;

    if (state.destination !== 'recommended' || !state.amount || state.amount <= 0) {
      row.style.display = 'none';
      qs('#impactWellbysDelta').hidden = true;
      qs('#impactDepressionYearsDelta').hidden = true;
      return;
    }
    row.style.display = '';

    if (state.boostBaseline === null || state.amount < state.boostBaseline) {
      state.boostBaseline = state.amount;
    }

    const baseline = state.boostBaseline;
    const max = Math.max(baseline * 3, baseline + 1);
    const sym = getCurrencySymbol(state.currency);
    slider.min = String(baseline);
    slider.max = String(max);
    slider.value = String(state.amount);
    valueEl.textContent = `${sym}${state.amount}`;
    if (minLabelEl) minLabelEl.textContent = `${sym}${baseline}`;
    if (maxLabelEl) maxLabelEl.textContent = `${sym}${max}`;

    const wellbysDeltaEl = qs('#impactWellbysDelta');
    const deprYrsDeltaEl = qs('#impactDepressionYearsDelta');
    const added = addedCharities();
    if (added.length === 0) {
      wellbysDeltaEl.hidden = true;
      deprYrsDeltaEl.hidden = true;
      return;
    }

    const splitFractions = currentSplitFractions();
    const baselineWellbys = calcWellbys(toUSD(baseline) * impactMultiplier(), splitFractions);
    const currentWellbys = calcWellbys(toUSD(state.amount) * impactMultiplier(), splitFractions);
    const deltaWellbys = currentWellbys - baselineWellbys;
    const deltaDepressionYears = deltaWellbys / 1.3;

    if (deltaWellbys > 0.005) {
      wellbysDeltaEl.textContent = `+${fmt(deltaWellbys)}`;
      wellbysDeltaEl.hidden = false;
      deprYrsDeltaEl.textContent = `+${fmt(deltaDepressionYears)}`;
      deprYrsDeltaEl.hidden = false;
    } else {
      wellbysDeltaEl.hidden = true;
      deprYrsDeltaEl.hidden = true;
    }
  }

  function renderImpact() {
    renderHliContribution();
    syncTimeframeUI('impactTimeframe', 'impactAgeInput');
    syncImpactLabels('impact');
    refreshBoostSlider();

    const emptyHint = qs('#allocationEmptyHint');
    if (emptyHint) emptyHint.hidden = addedCharities().length > 0;

    const amt = toUSD(state.amount || 0) * impactMultiplier();
    const wellbysEl = qs('#impactWellbys');
    const deprYrsEl = qs('#impactDepressionYears');
    const bkEl = qs('#impactBreakdown');
    const added = addedCharities();

    if (state.destination !== 'recommended' || amt <= 0 || added.length === 0) {
      wellbysEl.textContent = '—';
      deprYrsEl.textContent = '—';
      bkEl.innerHTML = state.destination === 'recommended' && added.length > 0 && state.impactTimeframe === 'lifetime'
        ? '<p class="impact-hint">Enter your age to see your lifetime impact.</p>'
        : '<p class="impact-hint">Add a charity and enter an amount to see your impact.</p>';
      added.forEach((c) => {
        const el = qs(`#outcome-${c.id}`);
        if (el) el.textContent = '—';
      });
      return;
    }

    const charityAmt = amt;
    const totalSplits = added.reduce((s, c) => s + (state.splits[c.id] || 0), 0);

    // If the boost slider has moved past the baseline, show each charity's
    // marginal outcome gain too (same baseline used for the WELLBYs/years delta).
    const hasBoost = state.boostBaseline !== null && state.amount > state.boostBaseline;
    const baselineAmt = hasBoost ? toUSD(state.boostBaseline) * impactMultiplier() : null;

    let totalWellbys = 0;
    const breakdown = [];

    added.forEach((c) => {
      const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
      const allocated = charityAmt * fraction;
      const wellbys = allocated / c.costPerWellby;
      const outcomes = allocated / c.costPerOutcome;
      totalWellbys += wellbys;
      if (wellbys > 0) {
        let outcomesDelta = null;
        if (hasBoost) {
          const baselineAllocated = baselineAmt * fraction;
          outcomesDelta = outcomes - (baselineAllocated / c.costPerOutcome);
        }
        breakdown.push({ name: c.name, outcomes, outcomesDelta, outcomeLabel: c.outcomeLabel });
      }
    });

    const depressionYears = totalWellbys / 1.3;

    wellbysEl.textContent = fmt(totalWellbys);
    deprYrsEl.textContent = fmt(depressionYears);
    bkEl.innerHTML = breakdown
      .map((b) => `<div class="impact-bk-row">
        <span class="impact-bk-name">${b.name}</span>
        <span class="impact-bk-delta">${b.outcomesDelta !== null && b.outcomesDelta > 0.005 ? `+${fmt(b.outcomesDelta)}` : ''}</span>
        <strong class="impact-bk-value">${fmt(b.outcomes)}</strong>
        <span class="impact-bk-label">${b.outcomeLabel}</span>
      </div>`)
      .join('');

    // Outcome cards
    added.forEach((c) => {
      const el = qs(`#outcome-${c.id}`);
      if (!el) return;
      const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
      const allocated = charityAmt * fraction;
      const outcomes = allocated / c.costPerOutcome;
      el.textContent = outcomes > 0 ? fmt(outcomes) : '—';
    });
  }

  // ── HLF impact preview (Amount step) ────────────────────────────────────
  const HLF_HLI_PCT = 0.10;
  const HLF_HLI_COST_PER_WELLBY = 9.5;
  const HLF_CHARITY_SPLIT = {
    strongminds: 0.33,
    'friendship-bench': 0.33,
    'pure-earth': 0.20,
    taimaka: 0.14,
  };

  function renderHlfImpact() {
    const card = qs('#hlfImpactCard');
    if (!card) return;

    if (state.destination !== 'hlf') {
      card.style.display = 'none';
      return;
    }
    card.style.display = '';
    syncTimeframeUI('hlfImpactTimeframe', 'hlfImpactAgeInput');
    syncImpactLabels('hlfImpact');

    const wellbysEl = qs('#hlfImpactWellbys');
    const deprYrsEl = qs('#hlfImpactDepressionYears');
    const bkEl = qs('#hlfImpactBreakdown');
    const amt = toUSD(state.amount || 0) * impactMultiplier();

    if (amt <= 0) {
      wellbysEl.textContent = '—';
      deprYrsEl.textContent = '—';
      bkEl.innerHTML = state.impactTimeframe === 'lifetime' && toUSD(state.amount || 0) > 0
        ? '<p class="impact-hint">Enter your age to see your lifetime impact.</p>'
        : '<p class="impact-hint">Enter an amount to see your impact.</p>';
      return;
    }

    const hliAmount = amt * HLF_HLI_PCT;
    const charityAmount = amt * (1 - HLF_HLI_PCT);
    let totalWellbys = hliAmount / HLF_HLI_COST_PER_WELLBY;
    const breakdown = [];

    Object.entries(HLF_CHARITY_SPLIT).forEach(([id, fraction]) => {
      const c = charities.find((ch) => ch.id === id);
      if (!c) return;
      const allocated = charityAmount * fraction;
      const wellbys = allocated / c.costPerWellby;
      const outcomes = allocated / c.costPerOutcome;
      totalWellbys += wellbys;
      if (wellbys > 0) breakdown.push({ name: c.name, outcomes, outcomeLabel: c.outcomeLabel });
    });

    const depressionYears = totalWellbys / 1.3;

    wellbysEl.textContent = fmt(totalWellbys);
    deprYrsEl.textContent = fmt(depressionYears);
    bkEl.innerHTML = breakdown
      .map((b) => `<div class="impact-bk-row">
        <span class="impact-bk-name">${b.name}</span>
        <span class="impact-bk-delta"></span>
        <strong class="impact-bk-value">${fmt(b.outcomes)}</strong>
        <span class="impact-bk-label">${b.outcomeLabel}</span>
      </div>`)
      .join('');
  }

  // ── Split sliders ────────────────────────────────────────────────────────
  // The visible "Total: X%" row was removed as redundant (sliders always sum
  // to 100% via redistributeSplits/normalizeSplits) — kept as a no-op call
  // site so the rest of the flow doesn't need to change.
  function renderSplitTotals() {}

  function syncSliderUI(id) {
    const slider = qs(`#range-${id}`);
    const label = qs(`#pct-${id}`);
    const val = Math.round(state.splits[id]);
    if (slider) slider.value = String(val);
    if (label) label.textContent = `${val}%`;
  }

  function syncLockUI(id) {
    const btn = qs(`#lock-${id}`);
    if (!btn) return;
    const locked = state.splitLocks[id];
    btn.classList.toggle('locked', locked);
    btn.setAttribute('aria-pressed', String(locked));
    btn.querySelector('.charity-lock-label').textContent = locked ? 'Unlock' : 'Lock';
  }

  function setLock(id, locked) {
    state.splitLocks[id] = locked;
    syncLockUI(id);
  }

  function normalizeSplits() {
    const added = addedCharities();
    if (added.length === 0) return;
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);
    if (total === 0) {
      const share = 100 / added.length;
      added.forEach((c) => { state.splits[c.id] = share; });
    } else if (Math.abs(total - 100) > 0.5) {
      added.forEach((c) => { state.splits[c.id] = (state.splits[c.id] / total) * 100; });
    }
    // Sync sliders to normalized values
    added.forEach((c) => syncSliderUI(c.id));
    renderSplitTotals();
    renderImpact();
  }

  // ── Review summary ────────────────────────────────────────────────────────
  function renderReview() {
    const sym = getCurrencySymbol(state.currency);
    const dest = state.destination === 'hlf'
      ? 'Happier Lives Fund'
      : state.destination === 'hli'
      ? 'Happier Lives Institute'
      : 'Recommended Charities';
    const freq = state.frequency !== 'one-off' ? '/month' : ' one-time';
    const total = Object.values(state.splits).reduce((s, v) => s + v, 0);

    let splits = '';
    let hliFeeRow = '';
    if (state.destination === 'recommended') {
      const amt = state.amount || 0;
      const hliAmount = amt * (state.hliPct / 100);
      splits = addedCharities().map((c) => `
          <div class="review-row"><span>${c.name}</span><span>${Math.round(state.splits[c.id] / (total / 100))}%</span></div>
        `).join('');
      if (hliAmount > 0) {
        hliFeeRow = `<div class="review-row"><span>HLI Research Contribution</span><span>${sym}${hliAmount.toFixed(2)}${freq}</span></div>`;
      }
    }

    let impact = '';
    if (state.destination === 'recommended') {
      const amt = toUSD(state.amount || 0);
      const charityAmt = amt;
      const totalSplits = Object.values(state.splits).reduce((s, v) => s + v, 0);
      let totalWellbys = 0;
      addedCharities().forEach((c) => {
        const fraction = totalSplits > 0 ? state.splits[c.id] / totalSplits : 0;
        totalWellbys += (charityAmt * fraction) / c.costPerWellby;
      });
      const deprYrs = totalWellbys / 1.3;
      if (totalWellbys > 0) {
        const perPeriod = state.frequency === 'monthly' ? '/month' : '';
        impact = `<div class="review-row impact-row"><span>Estimated impact</span><span>${fmt(deprYrs)} yrs depression averted${perPeriod}</span></div>`;
      }
    } else if (state.destination === 'hlf') {
      const amt = toUSD(state.amount || 0);
      const hliAmount = amt * HLF_HLI_PCT;
      const charityAmount = amt * (1 - HLF_HLI_PCT);
      let totalWellbys = hliAmount / HLF_HLI_COST_PER_WELLBY;
      Object.entries(HLF_CHARITY_SPLIT).forEach(([id, fraction]) => {
        const c = charities.find((ch) => ch.id === id);
        if (!c) return;
        totalWellbys += (charityAmount * fraction) / c.costPerWellby;
      });
      const deprYrs = totalWellbys / 1.3;
      if (totalWellbys > 0) {
        const perPeriod = state.frequency === 'monthly' ? '/month' : '';
        impact = `<div class="review-row impact-row"><span>Estimated impact</span><span>${fmt(deprYrs)} yrs depression averted${perPeriod}</span></div>`;
      }
    }

    const pledgeRow = state.frequency === 'pledge' && state.pledgeIncome && state.pledgePct
      ? `<div class="review-row"><span>Pledge</span><span>${state.pledgePct}% of ${sym}${state.pledgeIncome.toLocaleString()}/yr</span></div>`
      : '';

    const totalCharge = (state.amount || 0) + ((state.destination === 'recommended') ? (state.amount || 0) * (state.hliPct / 100) : 0);

    const addressParts = [
      state.donor.addressLine1,
      state.donor.addressLine2,
      state.donor.city,
      state.donor.state,
      state.donor.postalCode,
      state.donor.country,
    ].filter((part) => part && part.trim());
    const addressDisplay = addressParts.join(', ');

    qs('#reviewSummary').innerHTML = `
      <div class="review-row"><span>Name</span><span>${state.donor.firstName} ${state.donor.lastName}</span></div>
      <div class="review-row"><span>Email</span><span>${state.donor.email}</span></div>
      ${addressDisplay ? `<div class="review-row"><span>Address</span><span>${addressDisplay}</span></div>` : ''}
      <div class="review-row"><span>Giving to</span><span>${dest}</span></div>
      ${hliFeeRow
        ? `<div class="review-row"><span>Amount</span><span>${sym}${state.amount}${freq}</span></div>`
        : `<div class="review-row review-row--total"><span>Total charge</span><span>${sym}${state.amount}${freq}</span></div>`}
      ${pledgeRow}
      ${splits}
      ${hliFeeRow}
      ${hliFeeRow ? `<div class="review-row review-row--total"><span>Total charge</span><span>${sym}${totalCharge.toFixed(2)}${freq}</span></div>` : ''}
      ${impact}
      ${state.donor.giftAid ? '<div class="review-row"><span>Gift Aid</span><span>✓ Claimed</span></div>' : ''}
    `;

    const upsell = qs('#monthlyUpsell');
    if (upsell) upsell.style.display = state.frequency === 'one-off' ? 'block' : 'none';
  }

  // ── Stripe payment ────────────────────────────────────────────────────────
  let stripeInstance = null;
  let stripeElements = null;
  let paymentElementMounted = false;

  /** Lazy-load Stripe.js from CDN the first time it's needed */
  function loadStripeJs() {
    if (window.Stripe) return Promise.resolve(window.Stripe);
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://js.stripe.com/v3/';
      script.onload = () => resolve(window.Stripe);
      script.onerror = () => reject(new Error('Failed to load Stripe.js'));
      document.head.appendChild(script);
    });
  }

  /** Reset the payment UI and unmount the Payment Element */
  function teardownPaymentElement() {
    if (stripeElements) {
      const el = stripeElements.getElement('payment');
      if (el) el.unmount();
      stripeElements = null;
      paymentElementMounted = false;
    }
    qs('#paymentArea').style.display = 'none';
    qs('#paymentLoading').style.display = 'flex';
    qs('#paymentInitError').style.display = 'none';
    qs('#paymentError').style.display = 'none';
    qs('#payBtn').disabled = true;
  }

  /** Called when step 5 is entered — creates intent and mounts Payment Element */
  async function initPaymentElement() {
    teardownPaymentElement();

    try {
      // 1. Lazy-load Stripe.js
      const StripeConstructor = await loadStripeJs();
      if (!stripeInstance) stripeInstance = StripeConstructor(stripePublishableKey);

      // 2. Create PaymentIntent or Subscription on the server
      const response = await fetch('/api/create-payment-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount:       state.amount,
          currency:     state.currency,
          frequency:    state.frequency,
          pledgeIncome: state.pledgeIncome,
          pledgePct:    state.pledgePct,
          donor:        state.donor,
          destination:  state.destination,
          splits:       state.splits,
          hliPct:       state.hliPct,
        }),
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error ?? `Server error ${response.status}`);
      }

      const { clientSecret } = await response.json();

      // 3. Create Elements instance with HLI brand appearance
      stripeElements = stripeInstance.elements({
        clientSecret,
        appearance: {
          theme: 'stripe',
          variables: {
            colorPrimary:     '#1c3a5e',
            colorBackground:  '#ffffff',
            colorText:        '#1c3a5e',
            colorDanger:      '#c0392b',
            fontFamily:       'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            borderRadius:     '8px',
          },
          rules: {
            '.Input': {
              border:     '1.5px solid #e0dbd2',
              boxShadow:  'none',
            },
            '.Input:focus': {
              border:     '1.5px solid #1c3a5e',
              boxShadow:  '0 0 0 3px rgba(28,58,94,0.1)',
            },
            '.Label': {
              color:      '#4a5a50',
              fontSize:   '0.875rem',
              fontWeight: '500',
            },
          },
        },
      });

      // 4. Mount the Payment Element
      const paymentElement = stripeElements.create('payment', {
        layout: { type: 'tabs', defaultCollapsed: false },
        wallets: { applePay: 'auto', googlePay: 'auto' },
      });

      qs('#payment-element').innerHTML = '';
      paymentElement.mount('#payment-element');
      paymentElementMounted = true;

      // Enable Pay button once element is ready
      paymentElement.on('ready', () => {
        qs('#payBtn').disabled = false;
        qs('#paymentLoading').style.display = 'none';
        qs('#paymentArea').style.display = 'block';
      });

      // Clear inline errors when user edits payment details
      paymentElement.on('change', (event) => {
        if (event.complete) {
          qs('#paymentError').style.display = 'none';
          qs('#paymentError').textContent = '';
        }
      });

    } catch (err) {
      console.error('Payment init error:', err.message);
      qs('#paymentLoading').style.display = 'none';
      qs('#paymentInitError').style.display = 'block';
    }
  }

  /** Called when the Pay button is clicked */
  async function submitPayment() {
    if (!stripeInstance || !stripeElements) return;

    const payBtn  = qs('#payBtn');
    const errorEl = qs('#paymentError');

    payBtn.disabled    = true;
    payBtn.textContent = 'Processing…';
    errorEl.style.display = 'none';

    const { error } = await stripeInstance.confirmPayment({
      elements: stripeElements,
      confirmParams: {
        return_url: `${window.location.origin}/success`,
        payment_method_data: {
          billing_details: {
            name:  `${state.donor.firstName} ${state.donor.lastName}`.trim(),
            email: state.donor.email,
          },
        },
      },
      // Cards & wallets complete inline; redirect methods use return_url
      redirect: 'if_required',
    });

    if (error) {
      errorEl.textContent = (error.type === 'card_error' || error.type === 'validation_error')
        ? error.message
        : 'An unexpected error occurred. Please try again.';
      errorEl.style.display = 'block';
      payBtn.disabled    = false;
      payBtn.textContent = 'Pay now →';
    } else {
      // Inline success (card / wallet — no redirect needed)
      window.location.href = '/success';
    }
  }

  // ── Event listeners ───────────────────────────────────────────────────────
  function initEvents() {
    // Step 1: destination
    qsa('[name="destination"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.destination = radio.value;
        qsa('.option-card').forEach((c) => c.classList.remove('selected'));
        radio.closest('.option-card').classList.add('selected');
        renderNavButtons();
      });
    });

    // Step 2: amount presets (differ by frequency)
    const PRESETS_BY_FREQ = {
      monthly: { list: [10, 25, 50, 100, 250, 500], default: 50 },
      'one-off': { list: [25, 50, 100, 250, 500, 1000], default: 100 },
    };

    // Amount input/preset-button pattern on the main Amount step.
    const AMOUNT_INPUT_IDS = ['amount'];
    const PRESET_CONTAINER_IDS = ['presetAmounts'];

    function syncAmountInputs(amt) {
      AMOUNT_INPUT_IDS.forEach((id) => {
        const el = qs(`#${id}`);
        if (el) el.value = amt === null ? '' : String(amt);
      });
    }

    function syncPresetActiveState(amt) {
      qsa('.preset-btn').forEach((b) => b.classList.remove('active'));
      if (amt === null) return;
      qsa(`.preset-btn[data-amount="${amt}"]`).forEach((b) => b.classList.add('active'));
    }

    function bindPresetButtons() {
      qsa('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const amt = Number(btn.dataset.amount);
          state.amount = amt;
          state.boostBaseline = amt;
          syncAmountInputs(amt);
          syncPresetActiveState(amt);
          renderNavButtons();
          renderHlfImpact();
          renderImpact();
        });
      });
    }

    function renderPresets(freq, opts = {}) {
      const config = PRESETS_BY_FREQ[freq];
      if (!config) return;
      const buttonsHtml = config.list
        .map((n) => `<button type="button" class="preset-btn" data-amount="${n}">${n}</button>`)
        .join('');
      PRESET_CONTAINER_IDS.forEach((id) => {
        const container = qs(`#${id}`);
        if (!container) return;
        container.dataset.freq = freq;
        container.innerHTML = buttonsHtml;
      });
      bindPresetButtons();
      if (opts.applyDefault) {
        state.amount = config.default;
        state.boostBaseline = config.default;
        syncAmountInputs(config.default);
        syncPresetActiveState(config.default);
      }
    }

    // Step 2: frequency
    qsa('.freq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        qsa('.freq-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        state.frequency = btn.dataset.freq;
        const isPledge = state.frequency === 'pledge';
        qs('#pledgeCalculator').style.display = isPledge ? 'block' : 'none';
        qs('#manualAmountGroup').style.display = isPledge ? 'none' : 'block';
        if (!isPledge) {
          renderPresets(state.frequency);
          syncAmountInputs(state.amount);
          syncPresetActiveState(state.amount);
        } else {
          state.amount = null;
        }
        renderNavButtons();
        renderHlfImpact();
        renderImpact();
      });
    });

    // Step 2: pledge redirect link (disabled — element commented out above)
    qs('#pledgeRedirectLink')?.addEventListener('click', () => {
      qs('.freq-btn-pledge').click();
    });

    // Step 5: monthly upsell for one-time donors
    qs('#monthlyUpsellBtn')?.addEventListener('click', () => {
      state.frequency = 'monthly';
      state.donor.monthlyUpsellAccepted = true;
      renderReview();
      initPaymentElement();
    });

    // Step 2: currency
    qs('#currency').addEventListener('change', (e) => {
      state.currency = e.target.value;
      updateCurrencySymbol();
      renderHlfImpact();
    });

    // Step 2 amount input, and its mirror in the Allocate step's
    // "Change your donation amount" section — keep both in sync.
    AMOUNT_INPUT_IDS.forEach((id) => {
      qs(`#${id}`)?.addEventListener('input', (e) => {
        const amt = e.target.value ? Number(e.target.value) : null;
        state.amount = amt;
        state.boostBaseline = amt;
        syncAmountInputs(amt);
        syncPresetActiveState(amt);
        renderNavButtons();
        renderHlfImpact();
        renderImpact();
      });
    });

    // Step 2: preset amounts (initial bind + default selection for the default frequency)
    renderPresets(state.frequency, { applyDefault: true });

    // "Boost your impact" slider — deliberately does NOT touch state.boostBaseline,
    // since the whole point is a one-way floor the donor can't drag back below.
    qs('#boostSlider')?.addEventListener('input', (e) => {
      const min = Number(e.target.min);
      const amt = Math.max(Number(e.target.value), min);
      e.target.value = String(amt);
      state.amount = amt;
      syncAmountInputs(amt);
      syncPresetActiveState(amt);
      renderNavButtons();
      renderHlfImpact();
      renderImpact();
    });

    // Step 2: pledge calculator
    function updatePledgeAmount() {
      const income = state.pledgeIncome;
      const pct = state.pledgePct;
      if (income && pct) {
        state.amount = Math.round((income * pct / 100 / 12) * 100) / 100;
        qs('#pledgeResult').textContent =
          `That's ${getCurrencySymbol(state.currency)}${state.amount.toLocaleString()} per month.`;
      } else {
        state.amount = null;
        qs('#pledgeResult').textContent = '';
      }
      renderNavButtons();
      renderHlfImpact();
    }

    qs('#pledgeIncome').addEventListener('input', (e) => {
      state.pledgeIncome = e.target.value ? Number(e.target.value) : null;
      updatePledgeAmount();
    });

    qsa('[name="pledge-pct"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.pledgePct = Number(radio.value);
        updatePledgeAmount();
      });
    });

    // Impact timeframe (Per month / Per year / Lifetime) — Allocate step
    qsa('[name="impact-timeframe"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.impactTimeframe = radio.value;
        renderImpact();
      });
    });
    qs('#impactAge')?.addEventListener('input', (e) => {
      state.impactAge = e.target.value ? Number(e.target.value) : null;
      renderImpact();
    });

    // Impact timeframe (Per month / Per year / Lifetime) — HLF impact card
    qsa('[name="hlf-impact-timeframe"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.impactTimeframe = radio.value;
        renderHlfImpact();
      });
    });
    qs('#hlfImpactAge')?.addEventListener('input', (e) => {
      state.impactAge = e.target.value ? Number(e.target.value) : null;
      renderHlfImpact();
    });

    // Step 3: HLI percentage
    const hliCustomInput = qs('#hliCustomInput');
    const hliCustomPct = qs('#hliCustomPct');
    const hliCustomToggle = qs('#hliCustomToggle');

    qsa('[name="hli-pct"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        state.hliPct = Number(radio.value);
        renderImpact();
      });
    });

    hliCustomToggle.addEventListener('change', () => {
      if (hliCustomToggle.checked) {
        hliCustomInput.style.display = 'block';
        qsa('[name="hli-pct"]').forEach((r) => { r.checked = false; });
        hliCustomPct.focus();
      } else {
        hliCustomInput.style.display = 'none';
        hliCustomPct.value = '';
        // restore the 10% default
        const defaultRadio = qs('[name="hli-pct"][value="10"]');
        if (defaultRadio) { defaultRadio.checked = true; }
        state.hliPct = 10;
        renderImpact();
      }
    });

    hliCustomPct.addEventListener('input', () => {
      const raw = Number(hliCustomPct.value);
      state.hliPct = Math.min(100, Math.max(0, isNaN(raw) ? 0 : raw));
      renderImpact();
    });

    // Step 3: charity sliders — GWWC-style lock & auto-redistribute
    function redistributeSplits(draggedId, draggedVal) {
      const addedIds = state.addedCharityIds;
      const lockedIds = addedIds.filter((id) => id !== draggedId && state.splitLocks[id]);
      const otherIds = addedIds.filter((id) => id !== draggedId && !state.splitLocks[id]);

      const lockedTotal = lockedIds.reduce((s, id) => s + state.splits[id], 0);
      const maxForDragged = Math.max(0, 100 - lockedTotal);
      const val = Math.min(draggedVal, maxForDragged);

      state.splits[draggedId] = val;

      const remaining = Math.max(0, 100 - val - lockedTotal);

      if (otherIds.length === 0) {
        // Nothing left to absorb the remainder — nothing to do.
      } else if (otherIds.length === 1) {
        state.splits[otherIds[0]] = remaining;
      } else {
        const otherTotal = otherIds.reduce((s, id) => s + state.splits[id], 0);
        if (otherTotal > 0) {
          otherIds.forEach((id) => {
            state.splits[id] = (state.splits[id] / otherTotal) * remaining;
          });
        } else {
          const share = remaining / otherIds.length;
          otherIds.forEach((id) => { state.splits[id] = share; });
        }
      }

      addedIds.forEach((id) => syncSliderUI(id));
      renderSplitTotals();
      renderImpact();
    }

    function sliderRowHtml(c) {
      return `
        <div class="charity-slider-row" data-charity-id="${c.id}">
          <div class="charity-info">
            <span class="charity-name">${c.name}</span>
            <span class="charity-tier-badge charity-tier-badge--${c.tier}">
              ${c.tier === 'top' ? 'Top Charity' : 'Promising'}
            </span>
          </div>
          <input
            type="range"
            class="charity-range"
            id="range-${c.id}"
            min="0"
            max="100"
            value="0"
            step="1"
            aria-label="${c.name} percentage"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          />
          <span class="charity-pct-label" id="pct-${c.id}">0%</span>
          <button
            type="button"
            class="charity-lock-btn"
            id="lock-${c.id}"
            aria-pressed="false"
            aria-label="Lock ${c.name} percentage"
          >
            <svg class="charity-lock-icon charity-lock-icon--open" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/>
              <path d="M8 11V7a4 4 0 0 1 7.5-1.94" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
            </svg>
            <svg class="charity-lock-icon charity-lock-icon--closed" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/>
              <path d="M8 11V7a4 4 0 1 1 8 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="charity-lock-label">Lock</span>
          </button>
        </div>
      `;
    }

    function bindSliderRow(c) {
      const slider = qs(`#range-${c.id}`);
      const lockBtn = qs(`#lock-${c.id}`);
      if (!slider) return;

      slider.addEventListener('pointerdown', () => {
        // Grabbing a locked slider unlocks it so the drag can redistribute normally.
        if (state.splitLocks[c.id]) setLock(c.id, false);
      });

      slider.addEventListener('input', () => {
        const unlockedIds = state.addedCharityIds.filter((id) => !state.splitLocks[id]);
        const isLastTwoUnlocked = unlockedIds.length <= 2;

        redistributeSplits(c.id, Number(slider.value));

        // Lock the dragged slider once it's set, unless it's one of the last two unlocked sliders.
        if (!isLastTwoUnlocked) setLock(c.id, true);
      });

      lockBtn?.addEventListener('click', () => {
        setLock(c.id, !state.splitLocks[c.id]);
      });
    }

    function syncAddButtonUI(id) {
      const btn = qs(`#add-${id}`);
      if (!btn) return;
      const added = state.addedCharityIds.includes(id);
      btn.classList.toggle('added', added);
      btn.setAttribute('aria-pressed', String(added));
      const charity = charities.find((c) => c.id === id);
      btn.setAttribute('aria-label', added
        ? `Remove ${charity?.name} from your split`
        : `Add ${charity?.name} to your split`);
    }

    function equalizeAddedSplits() {
      const ids = state.addedCharityIds;
      if (ids.length === 0) return;
      const share = 100 / ids.length;
      ids.forEach((id) => {
        state.splits[id] = share;
        state.splitLocks[id] = false;
        syncSliderUI(id);
        syncLockUI(id);
      });
    }

    function addCharity(id) {
      if (state.addedCharityIds.includes(id)) return;
      const c = charities.find((ch) => ch.id === id);
      if (!c) return;

      state.addedCharityIds.push(id);
      state.splits[id] = 0;
      state.splitLocks[id] = false;

      const container = qs('#charitySplits');
      container.insertAdjacentHTML('beforeend', sliderRowHtml(c));
      bindSliderRow(c);

      equalizeAddedSplits();
      syncAddButtonUI(id);
      renderOutcomeCards();
      renderSplitTotals();
      renderImpact();
      renderNavButtons();
    }

    function removeCharity(id) {
      if (!state.addedCharityIds.includes(id)) return;

      state.addedCharityIds = state.addedCharityIds.filter((cid) => cid !== id);
      delete state.splits[id];
      delete state.splitLocks[id];

      qs(`.charity-slider-row[data-charity-id="${id}"]`)?.remove();

      equalizeAddedSplits();
      syncAddButtonUI(id);
      renderOutcomeCards();
      renderSplitTotals();
      renderImpact();
      renderNavButtons();
    }

    // Step 3: charity picker cards
    charities.forEach((c) => {
      qs(`#add-${c.id}`)?.addEventListener('click', () => {
        if (state.addedCharityIds.includes(c.id)) {
          removeCharity(c.id);
        } else {
          addCharity(c.id);
        }
      });

      // Static effectiveness stat on the picker card
      const effEl = qs(`#effectiveness-${c.id}`);
      if (effEl) {
        const yearsPerDollar = 1 / (c.costPerWellby * 1.3);
        effEl.innerHTML = `<strong class="charity-picker-stat-value">$${Math.round(1 / yearsPerDollar)}</strong> per Year of Depression Averted` +
          `<button type="button" class="info-btn" aria-label="About this figure" data-tooltip="For charities not focussing on alleviating mental health problems we use a “wellbeing gained” to “depression averted” conversion rate to calculate this figure">ⓘ</button>`;
      }
    });

    // Step 4: donor fields
    ['firstName', 'lastName', 'email', 'addressLine1', 'addressLine2', 'city', 'state', 'postalCode'].forEach((id) => {
      qs(`#${id}`)?.addEventListener('input', (e) => {
        state.donor[id] = e.target.value;
        renderNavButtons();
      });
    });

    function applyCountryRequirements(countryCode) {
      const req = addressRequirements(countryCode);

      qs('#addressLine1').required = req.addressLine1;
      qs('#city').required = req.city;
      qs('#state').required = req.state;
      qs('#postalCode').required = req.postalCode;

      qs('#stateOptionalTag').hidden = req.state;
      qs('#postalOptionalTag').hidden = req.postalCode;

      const addressNote = qs('#addressLine1Note');
      addressNote.hidden = countryCode !== 'GB';

      const postalNote = qs('#postalCodeNote');
      if (countryCode === 'US') {
        postalNote.textContent = 'Format: 5 digits, e.g. 94103 (or 94103-1234).';
        postalNote.hidden = false;
      } else if (countryCode === 'CA') {
        postalNote.textContent = 'Format: A1A 1A1.';
        postalNote.hidden = false;
      } else {
        postalNote.hidden = true;
      }

      const giftAidSection = qs('#giftAidSection');
      if (countryCode === 'GB') {
        giftAidSection.removeAttribute('hidden');
      } else {
        giftAidSection.setAttribute('hidden', '');
        qs('#giftAid').checked = false;
        state.donor.giftAid = false;
      }
    }

    // Step 4: country combobox (custom — native <datalist> can't be positioned/styled)
    const countryInput = qs('#country');
    const countryList = qs('#countryOptions');
    let countryActiveIndex = -1;
    let countryFiltered = [];

    function selectCountry(country) {
      countryInput.value = country ? country.name : countryInput.value;
      state.donor.country = countryInput.value;
      state.donor.countryCode = country ? country.code : '';
      applyCountryRequirements(state.donor.countryCode);
      closeCountryList();
      renderNavButtons();
    }

    function closeCountryList() {
      countryList.hidden = true;
      countryInput.setAttribute('aria-expanded', 'false');
      countryActiveIndex = -1;
    }

    function renderCountryList(query) {
      const q = query.trim().toLowerCase();
      countryFiltered = q
        ? countries.filter((c) => c.name.toLowerCase().includes(q))
        : countries;

      if (!countryFiltered.length) {
        closeCountryList();
        return;
      }

      countryList.innerHTML = countryFiltered
        .map((c, i) => `<li role="option" data-index="${i}" id="country-opt-${i}">${c.name}</li>`)
        .join('');
      countryList.hidden = false;
      countryInput.setAttribute('aria-expanded', 'true');
      countryActiveIndex = -1;
    }

    function highlightCountryOption(index) {
      qsa('.country-options li').forEach((li) => li.classList.remove('active'));
      if (index >= 0) {
        const el = qs(`#country-opt-${index}`);
        el?.classList.add('active');
        el?.scrollIntoView({ block: 'nearest' });
      }
      countryActiveIndex = index;
    }

    countryInput.addEventListener('input', (e) => {
      const typedName = e.target.value;
      const exactMatch = countries.find((c) => c.name === typedName);
      state.donor.country = typedName;
      state.donor.countryCode = exactMatch ? exactMatch.code : '';
      applyCountryRequirements(state.donor.countryCode);
      renderNavButtons();
      renderCountryList(typedName);
    });

    countryInput.addEventListener('focus', () => {
      renderCountryList(countryInput.value);
    });

    countryInput.addEventListener('keydown', (e) => {
      if (countryList.hidden && e.key !== 'Escape') return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        highlightCountryOption(Math.min(countryActiveIndex + 1, countryFiltered.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlightCountryOption(Math.max(countryActiveIndex - 1, 0));
      } else if (e.key === 'Enter') {
        if (countryActiveIndex >= 0) {
          e.preventDefault();
          selectCountry(countryFiltered[countryActiveIndex]);
        }
      } else if (e.key === 'Escape') {
        closeCountryList();
      }
    });

    countryList.addEventListener('click', (e) => {
      const li = e.target.closest('li[data-index]');
      if (!li) return;
      selectCountry(countryFiltered[Number(li.dataset.index)]);
    });

    document.addEventListener('click', (e) => {
      if (!qs('#countryCombobox').contains(e.target)) closeCountryList();
    });

    qs('#giftAid').addEventListener('change', (e) => {
      state.donor.giftAid = e.target.checked;
    });

    // Back / Next
    qs('#btnBack').addEventListener('click', () => {
      if (state.step === 5) teardownPaymentElement();
      const prev = prevStep();
      if (prev) goToStep(prev);
    });

    qs('#btnNext').addEventListener('click', () => {
      if (!isStepValid()) {
        highlightErrors();
        return;
      }
      if (state.step === 3) normalizeSplits();
      const next = nextStep();
      if (next) goToStep(next);
    });

    // Pay button
    qs('#payBtn').addEventListener('click', () => submitPayment());

    // Retry button (shown if API call fails)
    qs('#retryBtn').addEventListener('click', () => initPaymentElement());

    // Mockup-only bypass — lets reviewers reach /success without live Stripe keys configured
    qs('#mockupPayBtn')?.addEventListener('click', () => {
      window.location.href = '/success';
    });

    // Prevent info-btn clicks inside option-card labels from triggering radio selection
    qsa('.option-card .info-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => e.stopPropagation());
    });

    // Prevent the "Most impactful" info-btn from re-triggering the frequency button
    qsa('.freq-btn-info').forEach((btn) => {
      btn.addEventListener('click', (e) => e.stopPropagation());
    });

    // Tooltips
    initTooltips();
  }

  // ── Tooltips ──────────────────────────────────────────────────────────────
  function initTooltips() {
    const popup = qs('#tooltipPopup');
    const textEl = qs('#tooltipText');
    const TOOLTIP_MAX_WIDTH = 280;
    const VIEWPORT_MARGIN = 8;
    let hideTimer;
    let openBtn = null;

    function show(btn) {
      clearTimeout(hideTimer);
      openBtn = btn;
      textEl.textContent = btn.dataset.tooltip;
      popup.removeAttribute('hidden');
      const rect = btn.getBoundingClientRect();
      const scrollY = window.scrollY;
      const scrollX = window.scrollX;
      const popupHeight = popup.offsetHeight;
      const left = Math.max(
        VIEWPORT_MARGIN,
        Math.min(rect.left, window.innerWidth - TOOLTIP_MAX_WIDTH - VIEWPORT_MARGIN)
      );
      const fitsBelow = rect.bottom + popupHeight + VIEWPORT_MARGIN <= window.innerHeight;
      const top = fitsBelow
        ? rect.bottom + scrollY + 8
        : Math.max(VIEWPORT_MARGIN, rect.top + scrollY - popupHeight - 8);
      popup.style.left = `${left + scrollX}px`;
      popup.style.top = `${top}px`;
    }

    function hide() {
      hideTimer = setTimeout(() => {
        popup.setAttribute('hidden', '');
        openBtn = null;
      }, 150);
    }

    document.addEventListener('mouseover', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
      else if (!popup.contains(e.target)) hide();
    });

    // Tap-to-toggle so tooltips work on touch devices, which don't fire
    // hover/mouseover. Toggling (rather than only opening) lets a second tap
    // on the same button close it, since there's no hover-out to close it.
    // Uses the capture phase so it still runs even on info-btns inside
    // .option-card/.freq-toggle labels that stopPropagation() on bubble to
    // suppress the label's native radio-activation behavior.
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) {
        clearTimeout(hideTimer);
        if (openBtn === btn && !popup.hasAttribute('hidden')) {
          popup.setAttribute('hidden', '');
          openBtn = null;
        } else {
          show(btn);
        }
      } else if (!popup.contains(e.target)) {
        clearTimeout(hideTimer);
        popup.setAttribute('hidden', '');
        openBtn = null;
      }
    }, true);

    document.addEventListener('focusin', (e) => {
      const btn = e.target.closest('.info-btn[data-tooltip]');
      if (btn) show(btn);
    });

    document.addEventListener('focusout', (e) => {
      if (!e.relatedTarget?.closest?.('#tooltipPopup')) hide();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        popup.setAttribute('hidden', '');
        openBtn = null;
      }
    });

    popup.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    popup.addEventListener('mouseleave', hide);
  }

  // ── Error highlighting ────────────────────────────────────────────────────
  function highlightErrors() {
    if (state.step === 1) {
      qs('.option-list').classList.add('shake');
      setTimeout(() => qs('.option-list').classList.remove('shake'), 500);
    }
    if (state.step === 2) {
      qs('#amount').classList.add('error');
      setTimeout(() => qs('#amount').classList.remove('error'), 2000);
    }
    if (state.step === 3) {
      const grid = qs('#charityPickerGrid');
      grid?.classList.add('shake');
      setTimeout(() => grid?.classList.remove('shake'), 500);
    }
    if (state.step === 4) {
      ['firstName', 'lastName', 'email'].forEach((id) => {
        const el = qs(`#${id}`);
        if (!el?.value.trim() || (id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value))) {
          el?.classList.add('error');
          setTimeout(() => el?.classList.remove('error'), 2000);
        }
      });

      const req = addressRequirements(state.donor.countryCode);
      if (req.addressLine1 && !qs('#addressLine1').value.trim()) {
        qs('#addressLine1').classList.add('error');
        setTimeout(() => qs('#addressLine1').classList.remove('error'), 2000);
      }
      if (req.city && !qs('#city').value.trim()) {
        qs('#city').classList.add('error');
        setTimeout(() => qs('#city').classList.remove('error'), 2000);
      }
      if (req.state && !qs('#state').value.trim()) {
        qs('#state').classList.add('error');
        setTimeout(() => qs('#state').classList.remove('error'), 2000);
      }
      if (req.postalCode) {
        const postalEl = qs('#postalCode');
        if (!postalEl.value.trim() || !postalCodeFormatValid(state.donor.countryCode, postalEl.value)) {
          postalEl.classList.add('error');
          setTimeout(() => postalEl.classList.remove('error'), 2000);
        }
      }
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  async function init() {
    await loadFxRates();
    renderProgress();
    renderNavButtons();
    updateCurrencySymbol();
    renderSplitTotals();
    initEvents();
  }

  document.addEventListener('DOMContentLoaded', () => init());
</script>

